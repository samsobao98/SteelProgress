<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SteelProgress.Maui.Pages.ClientLimitationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SteelProgress.Core.ViewModels;assembly=SteelProgress.Core"
    x:DataType="vm:ClientLimitationsViewModel"
    BackgroundColor="{StaticResource SpBg}"
    Shell.NavBarIsVisible="False">

    <!-- Limitaciones de un cliente (maqueta del 2026-10-30). Se abre desde Clientes. -->
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,12,20,32" Spacing="14">
                <!-- Volver -->
                <HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="‹" FontSize="22" TextColor="{StaticResource SpText2}" VerticalOptions="Center" />
                    <Label Text="Clientes" FontSize="14" TextColor="{StaticResource SpText2}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Label Text="{Binding Title}" Style="{StaticResource SpTitle}" FontSize="24" />
                <Label Text="Lesiones, molestias o pautas de su fisio o médico. Las verás arriba cada vez que entrenes con este cliente."
                       Style="{StaticResource SpBody}" TextColor="{StaticResource SpText2}" />

                <!-- Antes de la primera: el consentimiento -->
                <VerticalStackLayout Spacing="14" IsVisible="{Binding NeedsConsent}">
                    <Border Style="{StaticResource SpCardStyle}" Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Son datos de salud" Style="{StaticResource SpBody}" FontFamily="SpaceGroteskMedium" />
                            <Label Text="Para guardarlos necesitas su permiso. Se quedan solo en este móvil y no salen al compartir rutinas."
                                   Style="{StaticResource SpSecondary}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnConsentTextTapped" />
                                </Grid.GestureRecognizers>
                                <CheckBox IsChecked="{Binding ConsentChecked}" Color="{StaticResource SpSteel1}" VerticalOptions="Start" />
                                <Label Grid.Column="1" Text="{Binding ConsentLabel}" Style="{StaticResource SpBody}" FontSize="14" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                    <Label Text="La app solo los apunta y te los recuerda. No propone ejercicios ni cambios: eso lo decides tú, con lo que diga su fisio o médico."
                           Style="{StaticResource SpSecondary}" />
                    <Button Text="+ Añadir limitación" Style="{StaticResource SpPrimaryButton}" IsEnabled="{Binding CanAdd}" Command="{Binding StartNewCommand}" />
                </VerticalStackLayout>

                <!-- Vigentes -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Current}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:LimitationItem">
                            <Border Style="{StaticResource SpCardStyle}" Padding="14,10,4,14">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                    <Label Text="{Binding Title}" Style="{StaticResource SpBody}" FontFamily="SpaceGroteskMedium" FontSize="16" VerticalOptions="Center" />
                                    <Label Grid.Row="1" Text="{Binding Text}" Style="{StaticResource SpBody}" FontSize="14" LineBreakMode="WordWrap" Margin="0,0,10,0" />
                                    <Label Grid.Row="2" Text="{Binding Meta}" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Label Grid.Column="1" Text="···" FontSize="20" TextColor="{StaticResource SpText3}" WidthRequest="44" HeightRequest="36"
                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                           SemanticProperties.Description="{Binding Title, StringFormat='Opciones de {0}'}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnItemOptionsTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Con consentimiento: añadir más, superadas y retirarlo -->
                <VerticalStackLayout Spacing="14" IsVisible="{Binding HasConsent}">
                    <Border StrokeThickness="1" Stroke="{StaticResource SpText4}" StrokeDashArray="4,3" StrokeShape="RoundRectangle 14"
                            HeightRequest="48" BackgroundColor="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding StartNewCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="+ Añadir limitación" Style="{StaticResource SpBody}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="10" IsVisible="{Binding HasResolved}">
                        <Grid ColumnDefinitions="*,Auto" Padding="2,4">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleResolvedCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding ResolvedHeader}" Style="{StaticResource SpBody}" TextColor="{StaticResource SpText2}" />
                            <Label x:Name="ResolvedChevron" Grid.Column="1" Text="⌄" FontSize="18" TextColor="{StaticResource SpText3}" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Resolved}" Spacing="10" IsVisible="{Binding ShowResolved}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:LimitationItem">
                                    <Border Style="{StaticResource SpCardStyle}" Padding="14,10,4,14" Opacity="0.7">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                            <Label Text="{Binding Title}" Style="{StaticResource SpBody}" FontFamily="SpaceGroteskMedium" VerticalOptions="Center" />
                                            <Label Grid.Row="1" Text="{Binding Text}" Style="{StaticResource SpBody}" FontSize="14" LineBreakMode="WordWrap" Margin="0,0,10,0" />
                                            <Label Grid.Row="2" Text="{Binding Meta}" Style="{StaticResource SpSecondary}" FontSize="12" />
                                            <Label Grid.Column="1" Text="···" FontSize="20" TextColor="{StaticResource SpText3}" WidthRequest="44" HeightRequest="36"
                                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                                   SemanticProperties.Description="{Binding Title, StringFormat='Opciones de {0}'}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnItemOptionsTapped" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource SpLine}" Margin="0,10,0,0" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="{Binding ConsentText}" Style="{StaticResource SpSecondary}" FontSize="12" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Retirar y borrar" Style="{StaticResource SpSecondaryButton}" TextColor="{StaticResource SpDanger}"
                                FontSize="13" Padding="12,0" HeightRequest="40" MinimumHeightRequest="40" Command="{Binding WithdrawConsentCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Hoja: nueva / editar limitación -->
        <Grid IsVisible="{Binding IsEditing}" BackgroundColor="#8C0A0A10">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CancelEditCommand}" />
            </Grid.GestureRecognizers>
            <Border Style="{StaticResource SpSheetStyle}" VerticalOptions="End">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <ScrollView>
                    <VerticalStackLayout Spacing="16">
                        <BoxView HeightRequest="4" WidthRequest="40" CornerRadius="2" Color="{StaticResource SpText4}" HorizontalOptions="Center" />
                        <Label Text="{Binding EditTitle}" Style="{StaticResource SpHeading}" />

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Zona" Style="{StaticResource SpSecondary}" FontSize="12" />
                            <FlexLayout x:Name="ZoneRow" Wrap="Wrap" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Lado (si aplica)" Style="{StaticResource SpSecondary}" FontSize="12" />
                            <Grid x:Name="SideRow" ColumnDefinitions="*,*,*" ColumnSpacing="8" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Qué tener en cuenta" Style="{StaticResource SpSecondary}" FontSize="12" />
                            <Editor Text="{Binding EditText}" AutoSize="TextChanges" MaxLength="300" Placeholder="Ej. sin saltos ni sentadilla por debajo de 90°"
                                    BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText3}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Pautas de" Style="{StaticResource SpSecondary}" FontSize="12" />
                            <Grid x:Name="SourceRow" ColumnDefinitions="*,*,*,*" ColumnSpacing="8" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource SpBg}" Padding="12,0">
                            <Label Text="Desde" Style="{StaticResource SpSecondary}" FontSize="12" VerticalOptions="Center" />
                            <DatePicker Grid.Column="1" Date="{Binding EditSince}" Format="dd/MM/yyyy" TextColor="{StaticResource SpText}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,2*" ColumnSpacing="8">
                            <Button Text="Cancelar" Style="{StaticResource SpSecondaryButton}" Command="{Binding CancelEditCommand}" />
                            <Button Grid.Column="1" Text="Guardar" Style="{StaticResource SpPrimaryButton}" Command="{Binding SaveCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
