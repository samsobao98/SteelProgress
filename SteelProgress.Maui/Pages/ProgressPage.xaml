<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SteelProgress.Maui.Pages.ProgressPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    BackgroundColor="#1E1E2E"
    Title="Progreso">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <Border
            Grid.Row="0"
            BackgroundColor="#313244"
            Margin="12,12,12,0"
            Padding="16"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="0">
            <VerticalStackLayout Spacing="4">
                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    Text="Progreso"
                    TextColor="#CDD6F4" />
                <Label
                    FontSize="13"
                    Text="Evolución del peso máximo por sesión"
                    TextColor="#BAC2DE" />
            </VerticalStackLayout>
        </Border>

        <!-- Selector de ejercicio -->
        <Border
            Grid.Row="1"
            BackgroundColor="#313244"
            Margin="12,10,12,0"
            Padding="14"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="0">
            <VerticalStackLayout Spacing="4">
                <Label FontSize="12" Text="Ejercicio" TextColor="#BAC2DE" />
                <Picker
                    BackgroundColor="#45475A"
                    ItemDisplayBinding="{Binding Name}"
                    ItemsSource="{Binding Exercises}"
                    SelectedItem="{Binding SelectedExercise, Mode=TwoWay}"
                    Title="Selecciona un ejercicio"
                    TitleColor="#585B70"
                    TextColor="#CDD6F4" />
            </VerticalStackLayout>
        </Border>

        <!-- Gráfica -->
        <Border
            Grid.Row="2"
            BackgroundColor="#313244"
            Margin="12,10,12,12"
            Padding="16"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="0">
            <Grid RowDefinitions="Auto,*">

                <Label
                    Grid.Row="0"
                    FontAttributes="Bold"
                    FontSize="15"
                    Margin="0,0,0,12"
                    Text="{Binding SelectedExercise.Name, TargetNullValue='Selecciona un ejercicio para ver su progreso'}"
                    TextColor="#CDD6F4" />

                <lvc:CartesianChart
                    Grid.Row="1"
                    Series="{Binding Series}"
                    XAxes="{Binding XAxes}"
                    YAxes="{Binding YAxes}"
                    BackgroundColor="Transparent" />

            </Grid>
        </Border>

    </Grid>

</ContentPage>
