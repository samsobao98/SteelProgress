<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SteelProgress.Maui.Pages.ProgressPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SteelProgress.Maui.Controls"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    BackgroundColor="{StaticResource SpBg}"
    Shell.NavBarIsVisible="False"
    Title="Progreso">

    <ContentPage.Resources>
        <!-- Pestañas internas: Resumen · Ejercicios · Historial -->
        <Style x:Key="SegmentLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource SpText3}" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="Segment" TargetType="Border">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="Padding" Value="0,9" />
        </Style>
        <Style x:Key="StatCaption" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource SpText3}" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <ScrollView x:Name="Scroller">
            <VerticalStackLayout Padding="20,20,20,32" Spacing="0">

                <Label Text="Progreso" Style="{StaticResource SpTitle}" />
                <!-- Con un cliente activo, estos datos son los suyos -->
                <controls:ActiveClientBanner Margin="0,12,0,0" />

                <!-- ── Pestañas ── -->
                <Border BackgroundColor="{StaticResource SpCard}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="4" Margin="0,16,0,16">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                        <Border Style="{StaticResource Segment}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSummary}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource SpCardHi}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowSummaryCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Resumen" Style="{StaticResource SegmentLabel}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSummary}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource SpText}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Segment}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsExercises}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource SpCardHi}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowExercisesCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Ejercicios" Style="{StaticResource SegmentLabel}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsExercises}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource SpText}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Segment}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsHistory}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource SpCardHi}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowHistoryCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Historial" Style="{StaticResource SegmentLabel}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsHistory}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource SpText}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </Grid>
                </Border>

                <!-- Sin entrenos todavía (para las tres pestañas) -->
                <VerticalStackLayout Spacing="6" Margin="0,24,0,0" IsVisible="False">
                    <VerticalStackLayout.Triggers>
                        <MultiTrigger TargetType="VerticalStackLayout">
                            <MultiTrigger.Conditions>
                                <BindingCondition Binding="{Binding IsLoaded}" Value="True" />
                                <BindingCondition Binding="{Binding HasData}" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="IsVisible" Value="True" />
                        </MultiTrigger>
                    </VerticalStackLayout.Triggers>
                    <Label Text="Aún no hay entrenos" Style="{StaticResource SpHeading}" HorizontalOptions="Center" />
                    <Label Text="Cuando guardes tu primer entreno verás aquí tu constancia, tus récords y cómo evoluciona cada ejercicio."
                           Style="{StaticResource SpSecondary}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- ═════════════ RESUMEN ═════════════ -->
                <VerticalStackLayout Spacing="0" IsVisible="False">
                    <VerticalStackLayout.Triggers>
                        <MultiTrigger TargetType="VerticalStackLayout">
                            <MultiTrigger.Conditions>
                                <BindingCondition Binding="{Binding IsSummary}" Value="True" />
                                <BindingCondition Binding="{Binding HasData}" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="IsVisible" Value="True" />
                        </MultiTrigger>
                    </VerticalStackLayout.Triggers>

                    <!-- Objetivo semanal, racha y volumen -->
                    <Border Style="{StaticResource SpCardStyle}" Padding="16">
                        <Grid ColumnDefinitions="112,*" ColumnSpacing="16">
                            <Grid WidthRequest="112" HeightRequest="112" VerticalOptions="Center">
                                <GraphicsView x:Name="GoalRing" />
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                                    <Label HorizontalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding WeekDone}" FontFamily="SpaceGroteskBold" FontSize="28" TextColor="{StaticResource SpText}" />
                                                <Span Text=" /" FontFamily="SpaceGroteskMedium" FontSize="16" TextColor="{StaticResource SpText3}" />
                                                <Span Text="{Binding WeekGoal}" FontFamily="SpaceGroteskMedium" FontSize="16" TextColor="{StaticResource SpText3}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="Esta semana" Style="{StaticResource StatCaption}" FontSize="10" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" Spacing="14" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="Racha" Style="{StaticResource StatCaption}" />
                                    <Label FontFamily="SpaceGroteskBold" FontSize="19" TextColor="{StaticResource SpText}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding StreakText}" />
                                                <Span Text=" 🔥" FontSize="15" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="Volumen del mes" Style="{StaticResource StatCaption}" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding MonthVolumeText}" FontFamily="SpaceGroteskBold" FontSize="19" TextColor="{StaticResource SpText}" />
                                        <Label Text="{Binding MonthDeltaText}" FontFamily="SpaceGroteskMedium" FontSize="13" TextColor="{StaticResource SpDanger}"
                                               VerticalOptions="Center" IsVisible="{Binding HasMonthDelta}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsMonthUp}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource SpOk}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                    <Label Text="frente al mismo tramo del mes pasado" Style="{StaticResource StatCaption}" FontSize="10" IsVisible="{Binding HasMonthDelta}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Calendario de constancia -->
                    <Border Style="{StaticResource SpCardStyle}" Padding="16,14" Margin="0,12,0,0">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Constancia" Style="{StaticResource SpHeading}" FontSize="15" />
                                <Label Grid.Column="1" Text="últimas 15 semanas" Style="{StaticResource StatCaption}" VerticalOptions="Center" />
                            </Grid>
                            <GraphicsView x:Name="CalendarView" HeightRequest="150" Margin="0,12,0,0" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                <Label Text="{Binding CalendarCaption}" Style="{StaticResource StatCaption}" VerticalOptions="Center" />
                                <HorizontalStackLayout x:Name="CalendarLegend" Grid.Column="1" Spacing="3" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Récords recientes -->
                    <Label Text="Récords recientes" Style="{StaticResource SpOverline}" Margin="0,22,0,8" />
                    <Label Text="Aún no hay récords: llegarán cuando superes lo que ya has hecho en un ejercicio."
                           Style="{StaticResource SpSecondary}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HasRecords}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentRecords}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SpCardStyle}" Padding="14,12">
                                    <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="12">
                                        <Border WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0"
                                                BackgroundColor="#3A3322" VerticalOptions="Center">
                                            <Label Text="★" FontSize="15" TextColor="{StaticResource SpRecord}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="{Binding ExerciseName}" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource SpText}" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Kind}" Style="{StaticResource StatCaption}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center">
                                            <Label Text="{Binding ValueText}" FontFamily="SpaceGroteskBold" FontSize="16" TextColor="{StaticResource SpRecord}" HorizontalOptions="End" />
                                            <Label Text="{Binding WhenText}" Style="{StaticResource StatCaption}" HorizontalOptions="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- ═════════════ EJERCICIOS ═════════════ -->
                <VerticalStackLayout Spacing="0" IsVisible="False">
                    <VerticalStackLayout.Triggers>
                        <MultiTrigger TargetType="VerticalStackLayout">
                            <MultiTrigger.Conditions>
                                <BindingCondition Binding="{Binding IsExercises}" Value="True" />
                                <BindingCondition Binding="{Binding HasData}" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="IsVisible" Value="True" />
                        </MultiTrigger>
                    </VerticalStackLayout.Triggers>

                    <!-- Gráfica del ejercicio elegido -->
                    <Border Style="{StaticResource SpCardStyle}" Padding="16,14" IsVisible="{Binding HasSelectedExercise}">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="{Binding SelectedExercise.Name}" Style="{StaticResource SpHeading}" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding SelectedExercise.BestText}" Style="{StaticResource SpSecondary}" />
                            <HorizontalStackLayout Spacing="14" Margin="0,10,0,0">
                                <HorizontalStackLayout Spacing="6">
                                    <BoxView WidthRequest="14" HeightRequest="3" Color="{StaticResource SpSteel1}" VerticalOptions="Center" />
                                    <Label Text="Peso máximo" Style="{StaticResource StatCaption}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="6">
                                    <BoxView WidthRequest="14" HeightRequest="3" Color="{StaticResource SpSteel3}" VerticalOptions="Center" />
                                    <Label Text="1RM estimado" Style="{StaticResource StatCaption}" />
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                            <lvc:CartesianChart HeightRequest="220" Margin="0,6,0,0" BackgroundColor="Transparent" Series="{Binding Series}" XAxes="{Binding XAxes}"
                                                YAxes="{Binding YAxes}" TooltipPosition="Hidden" LegendPosition="Hidden" />
                            <Label Text="El 1RM estimado (fórmula de Epley) es orientativo: los récords se cuentan por peso y repeticiones reales."
                                   Style="{StaticResource StatCaption}" FontSize="11" Margin="0,6,0,0" />
                        </VerticalStackLayout>
                    </Border>
                    <Label Text="Toca un ejercicio para ver cómo evoluciona." Style="{StaticResource SpSecondary}" Margin="0,0,0,4">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HasSelectedExercise}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <Label Text="Ejercicios entrenados" Style="{StaticResource SpOverline}" Margin="0,20,0,8" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ExerciseItems}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{StaticResource SpCard}" StrokeShape="RoundRectangle 14" StrokeThickness="0" Padding="14,12">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#2E3050" />
                                            <Setter Property="Stroke" Value="#B4BEFE" />
                                            <Setter Property="StrokeThickness" Value="1.5" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnExerciseTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="1">
                                            <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource SpText}" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding DetailText}" Style="{StaticResource StatCaption}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="{Binding BestText}" FontFamily="SpaceGroteskMedium" FontSize="13" TextColor="{StaticResource SpText2}" HorizontalOptions="End" />
                                            <Label Text="{Binding E1rmText}" Style="{StaticResource StatCaption}" HorizontalOptions="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- ═════════════ HISTORIAL ═════════════ -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sessions}" Spacing="8" IsVisible="False">
                    <VerticalStackLayout.Triggers>
                        <MultiTrigger TargetType="VerticalStackLayout">
                            <MultiTrigger.Conditions>
                                <BindingCondition Binding="{Binding IsHistory}" Value="True" />
                                <BindingCondition Binding="{Binding HasData}" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="IsVisible" Value="True" />
                        </MultiTrigger>
                    </VerticalStackLayout.Triggers>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SpCardStyle}" Padding="14,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSessionTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="1">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource SpText}" />
                                            <Border Style="{StaticResource SpChipStyle}" BackgroundColor="#3A3322" Padding="7,1" VerticalOptions="Center" IsVisible="{Binding HasStatus}">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsInProgress}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="#2E3050" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="{Binding StatusText}" FontFamily="OpenSansSemibold" FontSize="10" TextColor="{StaticResource SpIntensity}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsInProgress}" Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource SpSteel1}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding RoutineName}" Style="{StaticResource StatCaption}" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Detail}" FontFamily="SpaceGroteskMedium" FontSize="12" TextColor="{StaticResource SpText3}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding DateText}" Style="{StaticResource StatCaption}" HorizontalOptions="End" />
                                        <Label Text="{Binding FeelingEmoji}" FontSize="18" HorizontalOptions="End" IsVisible="{Binding HasFeeling}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═════════════ DETALLE DE SESIÓN (panel inferior) ═════════════ -->
        <Grid x:Name="DetailLayer" IsVisible="False">
            <BoxView x:Name="DetailBackdrop" BackgroundColor="#0A0A10" Opacity="0">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDetailCloseTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <!-- BindingContext: la sesión abierta (se pone al abrir, así no se vacía mientras se cierra) -->
            <!-- Alto según el contenido; la lista se desplaza si no cabe (DetailScroll.MaximumHeightRequest, en código) -->
            <Border x:Name="DetailSheet" Style="{StaticResource SpSheetStyle}" VerticalOptions="End">
                <VerticalStackLayout Spacing="0">
                    <VerticalStackLayout x:Name="DetailHeader" Spacing="0">
                        <BoxView WidthRequest="36" HeightRequest="4" CornerRadius="2" Color="{StaticResource SpText4}" HorizontalOptions="Center" Margin="0,0,0,14" />
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="{Binding RoutineName}" Style="{StaticResource SpOverline}" />
                                <Label Text="{Binding Title}" FontFamily="SpaceGroteskBold" FontSize="24" TextColor="{StaticResource SpText}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="{StaticResource SpCardHi}" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                    WidthRequest="32" HeightRequest="32" VerticalOptions="Start" SemanticProperties.Description="Cerrar">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDetailCloseTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="✕" FontSize="13" TextColor="{StaticResource SpText2}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding Subtitle}" Style="{StaticResource SpSecondary}" Margin="0,2,0,0" />
                        <Label Text="{Binding StatusText}" FontFamily="OpenSansSemibold" FontSize="12" TextColor="{StaticResource SpIntensity}"
                               Margin="0,6,0,0" IsVisible="{Binding HasStatus}" />
                        <Border BackgroundColor="{StaticResource SpCard}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,10" Margin="0,10,0,0"
                                IsVisible="{Binding HasNotes}">
                            <Label Text="{Binding Notes, StringFormat='«{0}»'}" Style="{StaticResource SpBody}" FontSize="14" FontAttributes="Italic" TextColor="{StaticResource SpText2}" />
                        </Border>
                    </VerticalStackLayout>

                    <ScrollView x:Name="DetailScroll" Margin="0,12,0,0">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exercises}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="2" Padding="0,10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource SpText}" LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="1" Text="{Binding RecordText}" FontFamily="OpenSansSemibold" FontSize="12" TextColor="{StaticResource SpRecord}"
                                                   VerticalOptions="Center" IsVisible="{Binding HasRecord}" />
                                        </Grid>
                                        <Label Text="{Binding SetsText}" FontFamily="SpaceGroteskMedium" FontSize="14" TextColor="{StaticResource SpText2}" />
                                        <Label Text="{Binding SetNotes}" FontFamily="OpenSansRegular" FontSize="13" FontAttributes="Italic" TextColor="{StaticResource SpText2}"
                                               Margin="0,2,0,0" IsVisible="{Binding HasSetNotes}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding ComparisonText}" Style="{StaticResource StatCaption}" IsVisible="{Binding HasComparison}" />
                                            <Label Grid.Column="1" Text="Evolución ›" FontFamily="OpenSansSemibold" FontSize="12" TextColor="{StaticResource SpSteel1}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnDetailExerciseTapped" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="{StaticResource SpLine}" Margin="0,10,0,0" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
