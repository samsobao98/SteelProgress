<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SteelProgress.Maui.Pages.ProgressPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#1E1E2E"
    Title="Progreso">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <Border
            Grid.Row="0"
            BackgroundColor="#313244"
            Margin="12,12,12,0"
            Padding="16"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="0">
            <VerticalStackLayout Spacing="4">
                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    Text="Progreso"
                    TextColor="#CDD6F4" />
                <Label
                    FontSize="13"
                    Text="{Binding SelectedExercise.Name, TargetNullValue='Peso máximo por sesión'}"
                    TextColor="#BAC2DE" />
            </VerticalStackLayout>
        </Border>

        <!-- Selector de ejercicio -->
        <Border
            Grid.Row="1"
            BackgroundColor="#313244"
            Margin="12,10,12,0"
            Padding="14"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="0">
            <VerticalStackLayout Spacing="4">
                <Label FontSize="12" Text="Ejercicio" TextColor="#BAC2DE" />
                <Picker
                    BackgroundColor="#45475A"
                    ItemDisplayBinding="{Binding Name}"
                    ItemsSource="{Binding Exercises}"
                    SelectedItem="{Binding SelectedExercise, Mode=TwoWay}"
                    Title="Selecciona un ejercicio"
                    TitleColor="#585B70"
                    TextColor="#CDD6F4" />
            </VerticalStackLayout>
        </Border>

        <!-- Lista de entradas de progreso -->
        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding ProgressEntries}"
            Margin="12,10,12,12">
            <CollectionView.EmptyView>
                <Label
                    HorizontalTextAlignment="Center"
                    Text="Sin datos para este ejercicio"
                    TextColor="#585B70"
                    VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        BackgroundColor="#313244"
                        Margin="0,0,0,8"
                        Padding="14,12"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="0">
                        <Grid ColumnDefinitions="Auto,*,Auto">

                            <!-- Fecha -->
                            <Label
                                Grid.Column="0"
                                FontSize="13"
                                Text="{Binding Date, StringFormat='{0:dd/MM/yy}'}"
                                TextColor="#6C7086"
                                VerticalOptions="Center"
                                WidthRequest="65" />

                            <!-- Barra fija decorativa -->
                            <BoxView
                                Grid.Column="1"
                                BackgroundColor="#45475A"
                                CornerRadius="3"
                                HeightRequest="8"
                                HorizontalOptions="Fill"
                                Margin="8,0"
                                VerticalOptions="Center" />

                            <!-- Peso máximo -->
                            <Label
                                Grid.Column="2"
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="{Binding MaxWeight, StringFormat='{0} kg'}"
                                TextColor="#89B4FA"
                                VerticalOptions="Center" />

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
