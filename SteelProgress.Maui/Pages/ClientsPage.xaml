<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SteelProgress.Maui.Pages.ClientsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SteelProgress.Core.ViewModels;assembly=SteelProgress.Core"
    x:DataType="vm:ClientsViewModel"
    BackgroundColor="{StaticResource SpBg}"
    Shell.NavBarIsVisible="False">

    <!-- Clientes del entrenador (maqueta 3). Solo en vista entrenador. -->
    <Grid>
        <Ellipse Fill="{StaticResource SpIntensity}" Opacity="0.07" WidthRequest="280" HeightRequest="280"
                 HorizontalOptions="End" VerticalOptions="Start" Margin="0,-80,-100,0" InputTransparent="True" />

        <Grid RowDefinitions="Auto,*" Padding="20,12,20,0">
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,12">
                <VerticalStackLayout VerticalOptions="End">
                    <Label Text="Clientes" Style="{StaticResource SpTitle}" />
                    <Label Text="{Binding Summary}" Style="{StaticResource SpSecondary}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="+ Cliente" Style="{StaticResource SpPrimaryButton}" Padding="16,10"
                        VerticalOptions="Center" Command="{Binding StartNewCommand}" />
            </Grid>

            <CollectionView x:Name="ClientList" Grid.Row="1" ItemsSource="{Binding Clients}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="0,60" Spacing="10" HorizontalOptions="Center">
                        <Label Text="Aún no tienes clientes" Style="{StaticResource SpHeading}" HorizontalOptions="Center" />
                        <Label Text="Añade uno para prepararle rutinas y registrar sus sesiones."
                               Style="{StaticResource SpSecondary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClientItem">
                        <Grid Padding="0,0,0,8">
                            <Border Style="{StaticResource SpCardStyle}" Padding="12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnClientTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 22"
                                            BackgroundColor="{Binding Client.AvatarColor}" VerticalOptions="Center">
                                        <Label Text="{Binding Initial}" FontFamily="SpaceGroteskMedium" FontSize="18"
                                               TextColor="{StaticResource SpOnAccent}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Client.Name}" Style="{StaticResource SpBody}" FontFamily="SpaceGroteskMedium" />
                                        <Label Text="{Binding Subtitle}" Style="{StaticResource SpSecondary}" FontSize="12" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding LimitationsText}" IsVisible="{Binding HasLimitations}" FontSize="12"
                                               FontFamily="SpaceGroteskMedium" TextColor="{StaticResource SpIntensity}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" Style="{StaticResource SpChipStyle}" BackgroundColor="#26A6E3A1"
                                            VerticalOptions="Center" IsVisible="{Binding HasBadge}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding BadgeIsWarning}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#26EF8A8A" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding Badge}" FontSize="11" FontFamily="SpaceGroteskMedium" TextColor="{StaticResource SpOk}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding BadgeIsWarning}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource SpDanger}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <!-- Archivados, plegados al final -->
                <CollectionView.Footer>
                    <VerticalStackLayout x:DataType="vm:ClientsViewModel" Spacing="8" Padding="0,8,0,24" IsVisible="{Binding HasArchived}">
                        <Grid ColumnDefinitions="*,Auto" Padding="2,8">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleArchivedCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding ArchivedHeader}" Style="{StaticResource SpBody}" TextColor="{StaticResource SpText2}" />
                            <Label Grid.Column="1" Text="⌄" FontSize="18" TextColor="{StaticResource SpText3}" />
                        </Grid>
                        <Label Text="Ya no entrenan contigo: no salen en Inicio, pero su historial se guarda."
                               Style="{StaticResource SpSecondary}" FontSize="12" IsVisible="{Binding ShowArchived}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ArchivedClients}" Spacing="8" IsVisible="{Binding ShowArchived}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ClientItem">
                                    <Border Style="{StaticResource SpCardStyle}" Padding="12" Opacity="0.7">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnClientTapped" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 20"
                                                    BackgroundColor="{Binding Client.AvatarColor}" VerticalOptions="Center">
                                                <Label Text="{Binding Initial}" FontFamily="SpaceGroteskMedium" FontSize="16"
                                                       TextColor="{StaticResource SpOnAccent}" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding Client.Name}" Style="{StaticResource SpBody}" FontFamily="SpaceGroteskMedium" />
                                                <Label Text="{Binding Subtitle}" Style="{StaticResource SpSecondary}" FontSize="12" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </Grid>

        <!-- Panel: nuevo / editar cliente -->
        <Grid IsVisible="{Binding IsEditing}" BackgroundColor="#8C0A0A10">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CancelEditCommand}" />
            </Grid.GestureRecognizers>
            <Border Style="{StaticResource SpSheetStyle}" VerticalOptions="End">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="14">
                    <BoxView HeightRequest="4" WidthRequest="40" CornerRadius="2" Color="{StaticResource SpText4}" HorizontalOptions="Center" />
                    <Label Text="{Binding EditTitle}" Style="{StaticResource SpHeading}" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nombre" Style="{StaticResource SpSecondary}" FontSize="12" />
                        <Entry Text="{Binding EditName}" Placeholder="Nombre del cliente" BackgroundColor="{StaticResource SpBg}"
                               TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Objetivo" Style="{StaticResource SpSecondary}" FontSize="12" />
                        <Entry Text="{Binding EditGoal}" Placeholder="Ej. Hipertrofia, fuerza, recomposición" BackgroundColor="{StaticResource SpBg}"
                               TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Notas" Style="{StaticResource SpSecondary}" FontSize="12" />
                        <Editor Text="{Binding EditNotes}" AutoSize="TextChanges" Placeholder="Preferencias, horarios… (las lesiones, en Limitaciones)"
                                BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                    </VerticalStackLayout>

                    <!-- Solo la fecha de firma: el cuestionario se rellena fuera de la app -->
                    <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                        <CheckBox IsChecked="{Binding EditHasParq}" Color="{StaticResource SpSteel1}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Ha firmado el PAR-Q+" Style="{StaticResource SpBody}" FontSize="14" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnParqLabelTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                        <DatePicker Grid.Column="2" Date="{Binding EditParqDate}" Format="dd/MM/yyyy" IsVisible="{Binding EditHasParq}"
                                    TextColor="{StaticResource SpText}" VerticalOptions="Center" />
                    </Grid>
                    <!-- Web oficial del PAR-Q+: el documento no va dentro de la app (tiene derechos de autor) -->
                    <Label Text="Descargar el PAR-Q+ oficial (eparmedx.com)" FontSize="13" TextColor="{StaticResource SpSteel1}"
                           TextDecorations="Underline" Margin="44,0,0,0" Padding="0,6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnParqLinkTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Días que entrena" Style="{StaticResource SpSecondary}" FontSize="12" />
                        <HorizontalStackLayout x:Name="DayRow" Spacing="6" />
                        <Label x:Name="DayHint" Style="{StaticResource SpSecondary}" FontSize="12" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Color" Style="{StaticResource SpSecondary}" FontSize="12" />
                        <HorizontalStackLayout x:Name="ColorRow" Spacing="10" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,2*" ColumnSpacing="8">
                        <Button Text="Cancelar" Style="{StaticResource SpSecondaryButton}" Command="{Binding CancelEditCommand}" />
                        <Button Grid.Column="1" Text="Guardar" Style="{StaticResource SpPrimaryButton}" Command="{Binding SaveCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
