<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SteelProgress.Maui.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:controls="clr-namespace:SteelProgress.Maui.Controls"
    BackgroundColor="{StaticResource SpBg}"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="StatValue" TargetType="Label">
            <Setter Property="FontFamily" Value="SpaceGroteskBold" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="TextColor" Value="{StaticResource SpText}" />
        </Style>
        <Style x:Key="StatCaption" TargetType="Label">
            <Setter Property="FontFamily" Value="SpaceGroteskRegular" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource SpText3}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout x:Name="PageBody" Padding="20,16,20,32" Spacing="0" Opacity="0">

            <!-- ── Cabecera: avatar, saludo y Ajustes ── -->
            <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="14" Margin="0,4,0,20">
                <Border BackgroundColor="{Binding ProfileColor}" HeightRequest="48" WidthRequest="48"
                        StrokeShape="RoundRectangle 24" StrokeThickness="0" VerticalOptions="Center">
                    <Label Text="{Binding ProfileInitial}" FontFamily="SpaceGroteskBold" FontSize="21"
                           TextColor="{StaticResource SpOnAccent}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                    <Label Text="{Binding Greeting}" Style="{StaticResource SpSecondary}" FontSize="12" />
                    <Label Text="{Binding ProfileName}" FontFamily="SpaceGroteskBold" FontSize="23" TextColor="{StaticResource SpText}"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <Border x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource SpCardStyle}" Padding="0"
                        WidthRequest="42" HeightRequest="42" VerticalOptions="Center"
                        SemanticProperties.Description="Ajustes">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSettingsTapped" />
                    </Border.GestureRecognizers>
                    <mi:MauiIcon Icon="{mi:Material Settings}" IconColor="{StaticResource SpText2}" IconSize="20"
                                 HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Con un cliente activo, estos datos son los suyos -->
            <controls:ActiveClientBanner Margin="0,0,0,12" />

            <!-- ══ Inicio personal (y el de un cliente activo, en tercera persona) ══ -->
            <VerticalStackLayout IsVisible="{Binding ShowPersonal}" Spacing="0">

            <!-- ── Semana: días entrenados, hoy con contorno ── -->
            <Grid x:Name="WeekStrip" ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="6" Margin="0,0,0,16" />

            <!-- ── Hoy toca ── -->
            <Border x:Name="TodayCard" BackgroundColor="{StaticResource SpCardHi}" StrokeShape="RoundRectangle 20"
                    Stroke="#343A55" StrokeThickness="1" Padding="18,16,18,18" IsVisible="{Binding ShowToday}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="{Binding TodayDoneText}" FontFamily="SpaceGroteskMedium" FontSize="13" TextColor="{StaticResource SpOk}"
                           Margin="0,0,0,10" IsVisible="{Binding HasTodayDone}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Text="{Binding TodayLabel}" Style="{StaticResource SpOverline}" TextColor="{StaticResource SpSteel2}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding TodayRoutineText}" Style="{StaticResource SpSecondary}" FontSize="12"
                               HorizontalOptions="End" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding TodayDayName}" FontFamily="SpaceGroteskBold" FontSize="28" TextColor="{StaticResource SpText}"
                           Margin="0,6,0,0" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding TodayDetail}" Style="{StaticResource SpSecondary}" Margin="0,2,0,0" />

                    <!-- Los primeros ejercicios del día -->
                    <FlexLayout x:Name="TodayChips" Wrap="Wrap" Margin="0,12,0,0" IsVisible="{Binding CanStartToday}" />

                    <Border x:Name="StartButton" Background="{StaticResource SpSteelBrush}" Padding="0,16" StrokeShape="RoundRectangle 14"
                            StrokeThickness="0" Margin="0,10,0,0" IsVisible="{Binding CanStartToday}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStartTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding StartTodayText}" FontFamily="SpaceGroteskMedium" FontSize="16" TextColor="{StaticResource SpOnAccent}"
                               HorizontalOptions="Center" />
                    </Border>
                    <Label Text="Elegir otro entreno ›" FontFamily="SpaceGroteskMedium" FontSize="14" TextColor="{StaticResource SpSteel1}"
                           HorizontalOptions="Center" Padding="12,12,12,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOtherWorkoutTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- Entreno en curso -->
            <Border BackgroundColor="{StaticResource SpCardHi}" StrokeShape="RoundRectangle 20" Stroke="#343A55" StrokeThickness="1"
                    Padding="18,16,18,18" IsVisible="{Binding ShowActiveWorkout}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="● Entreno en curso" Style="{StaticResource SpOverline}" TextColor="{StaticResource SpOk}" />
                    <Label Text="Tienes un entreno a medias" Style="{StaticResource SpHeading}" Margin="0,6,0,0" />
                    <Border Background="{StaticResource SpSteelBrush}" Padding="0,16" StrokeShape="RoundRectangle 14" StrokeThickness="0" Margin="0,14,0,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOtherWorkoutTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="▶ Continuar entreno" FontFamily="SpaceGroteskMedium" FontSize="16" TextColor="{StaticResource SpOnAccent}" HorizontalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Sin rutinas -->
            <Border Style="{StaticResource SpCardStyle}" Padding="18" IsVisible="{Binding ShowNoRoutines}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding NoRoutinesTitle}" Style="{StaticResource SpHeading}" />
                    <Label Text="{Binding NoRoutinesText}" Style="{StaticResource SpSecondary}" />
                    <Border Background="{StaticResource SpSteelBrush}" Padding="0,15" StrokeShape="RoundRectangle 14" StrokeThickness="0" Margin="0,8,0,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRoutinesTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding NoRoutinesButtonText}" FontFamily="SpaceGroteskMedium" FontSize="15" TextColor="{StaticResource SpOnAccent}" HorizontalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- ── Números ── -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,16,0,0">
                <Border Style="{StaticResource SpCardStyle}" Padding="14,12">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="{Binding SessionCount}" Style="{StaticResource StatValue}" />
                        <Label Text="Sesiones" Style="{StaticResource StatCaption}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource SpCardStyle}" Padding="14,12">
                    <VerticalStackLayout Spacing="0">
                        <Label Style="{StaticResource StatValue}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding WeekStreak}" />
                                    <Span Text=" 🔥" FontSize="17" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Text="Semanas seguidas" Style="{StaticResource StatCaption}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SpCardStyle}" Padding="14,12">
                    <VerticalStackLayout Spacing="0">
                        <Label Style="{StaticResource StatValue}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding MonthRecords}" />
                                    <Span Text=" ★" FontSize="17" TextColor="{StaticResource SpRecord}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Text="Récords mes" Style="{StaticResource StatCaption}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- ── Últimas sesiones ── -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,24,0,8">
                <Label Text="{Binding RecentTitle}" Style="{StaticResource SpOverline}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="Ver historial ›" FontFamily="SpaceGroteskMedium" FontSize="13" TextColor="{StaticResource SpSteel1}"
                       IsVisible="{Binding HasSessions}" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHistoryTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
            <Label Text="{Binding RecentEmptyText}" Style="{StaticResource SpSecondary}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding HasSessions}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentSessions}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SpCardStyle}" Padding="14,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSessionTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="12">
                                <!-- ✓ completo, ! a medias, ▶ en curso -->
                                <Border WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0"
                                        BackgroundColor="#1F3327" VerticalOptions="Center">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsIncomplete}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#3A3322" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsInProgress}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#262B40" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="✓" FontFamily="SpaceGroteskMedium" FontSize="14" TextColor="{StaticResource SpOk}"
                                           HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsIncomplete}" Value="True">
                                                <Setter Property="Text" Value="!" />
                                                <Setter Property="TextColor" Value="{StaticResource SpIntensity}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsInProgress}" Value="True">
                                                <Setter Property="Text" Value="▶" />
                                                <Setter Property="FontSize" Value="11" />
                                                <Setter Property="TextColor" Value="{StaticResource SpSteel1}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" FontFamily="SpaceGroteskMedium" FontSize="15" TextColor="{StaticResource SpText}" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Detail}" FontFamily="SpaceGroteskMedium" FontSize="12" TextColor="{StaticResource SpText3}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{StaticResource SpText3}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- ══ Inicio de un perfil de entrenador sin cliente activo: sus clientes ══ -->
            <controls:CoachHomeView IsVisible="{Binding ShowCoachOverview}" ClientTapped="OnCoachClientTapped" GoToClients="OnGoToClientsTapped" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
