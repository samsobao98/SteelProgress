<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SteelProgress.Maui.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SteelProgress.Core.ViewModels;assembly=SteelProgress.Core"
    xmlns:converters="clr-namespace:SteelProgress.Maui.Converters"
    x:DataType="vm:ProfileViewModel"
    BackgroundColor="{StaticResource SpBg}"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <converters:PlateColorConverter x:Key="PlateColor" />
        <converters:PlateHeightConverter x:Key="PlateHeight" />
        <converters:InvertedBoolConverter x:Key="Not" />
    </ContentPage.Resources>

    <!-- Primera pantalla hecha con el sistema de diseño (Resources/Styles/Tokens.xaml) -->
    <Grid>
        <Ellipse
            Fill="{StaticResource SpSteel3}"
            Opacity="0.06"
            WidthRequest="280"
            HeightRequest="280"
            HorizontalOptions="End"
            VerticalOptions="Start"
            Margin="0,-90,-110,0"
            InputTransparent="True" />

        <ScrollView>
            <VerticalStackLayout x:Name="PageContent" Padding="20,12,20,32" Spacing="0">

                <!-- Volver -->
                <HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="‹" FontSize="22" TextColor="{StaticResource SpText2}" VerticalOptions="Center" />
                    <Label Text="Inicio" FontSize="14" TextColor="{StaticResource SpText2}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Label Text="Perfil" Style="{StaticResource SpTitle}" Margin="0,8,0,16" />

                <!-- ── Quién eres: avatar, nombre, tipo y frase ── -->
                <Border Style="{StaticResource SpCardStyle}" Padding="16" IsVisible="{Binding IsEditing, Converter={StaticResource Not}}">
                    <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="14">
                        <Border BackgroundColor="{Binding ProfileColor}" WidthRequest="64" HeightRequest="64"
                                StrokeShape="RoundRectangle 32" StrokeThickness="0" VerticalOptions="Center">
                            <Grid>
                                <Label Text="{Binding ProfileInitial}" FontFamily="SpaceGroteskBold" FontSize="28" TextColor="{StaticResource SpOnAccent}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                <Image Source="{Binding ProfilePhoto}" IsVisible="{Binding HasProfilePhoto}" Aspect="AspectFill" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding ProfileName}" FontFamily="SpaceGroteskBold" FontSize="21" TextColor="{StaticResource SpText}"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding KindLabel}" Style="{StaticResource SpSecondary}" FontSize="13" />
                            <Label Text="{Binding ProfileDescription, StringFormat='«{0}»'}" IsVisible="{Binding HasProfileDescription}"
                                   FontFamily="SpaceGroteskMedium" FontAttributes="Italic" FontSize="13" TextColor="{StaticResource SpText2}" Margin="0,4,0,0" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="Editar" Style="{StaticResource SpSecondaryButton}" Padding="14,0" HeightRequest="40" MinimumHeightRequest="40"
                                VerticalOptions="Start" Command="{Binding StartEditCommand}" />
                    </Grid>
                </Border>

                <!-- Editando: en el mismo sitio, sin ventana aparte -->
                <Border Style="{StaticResource SpCardStyle}" Padding="16" IsVisible="{Binding IsEditing}">
                    <VerticalStackLayout Spacing="14">
                        <!-- Tocar el avatar: foto de la galería o de la cámara -->
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Border x:Name="EditAvatar" BackgroundColor="{Binding EditColor}" WidthRequest="88" HeightRequest="88"
                                    StrokeShape="RoundRectangle 44" StrokeThickness="0" HorizontalOptions="Center"
                                    SemanticProperties.Description="Cambiar la foto">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEditAvatarTapped" />
                                </Border.GestureRecognizers>
                                <Grid>
                                    <Label Text="{Binding EditInitial}" FontFamily="SpaceGroteskBold" FontSize="36" TextColor="{StaticResource SpOnAccent}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Image Source="{Binding EditPhoto}" IsVisible="{Binding HasEditPhoto}" Aspect="AspectFill" />
                                </Grid>
                            </Border>
                            <Label FontFamily="SpaceGroteskMedium" FontSize="13" TextColor="{StaticResource SpSteel1}" HorizontalOptions="Center"
                                   IsVisible="{Binding CanChoosePhoto}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding HasEditPhoto}" Value="True">
                                        <Setter Property="Text" Value="Cambiar foto" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding HasEditPhoto}" Value="False">
                                        <Setter Property="Text" Value="Añadir foto" />
                                    </DataTrigger>
                                </Label.Triggers>
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEditAvatarTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Nombre" Style="{StaticResource SpSecondary}" FontSize="12" />
                            <Entry Text="{Binding EditName}" Placeholder="Tu nombre" MaxLength="30" BackgroundColor="{StaticResource SpBg}"
                                   TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Frase (opcional)" Style="{StaticResource SpSecondary}" FontSize="12" />
                            <Entry Text="{Binding EditDescription}" Placeholder="Algo que te motive" MaxLength="60" BackgroundColor="{StaticResource SpBg}"
                                   TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Color (se ve sin foto)" Style="{StaticResource SpSecondary}" FontSize="12" />
                            <FlexLayout x:Name="ColorRow" Wrap="Wrap" JustifyContent="Start" Padding="4,4,0,0" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,2*" ColumnSpacing="8">
                            <Button Text="Cancelar" Style="{StaticResource SpSecondaryButton}" Command="{Binding CancelEditCommand}" />
                            <Button Grid.Column="1" Text="Guardar" Style="{StaticResource SpPrimaryButton}" Command="{Binding SaveEditCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ── Tipo de perfil: para tus entrenos o para tus clientes ── -->
                <Label Text="Tipo de perfil" Style="{StaticResource SpOverline}" Margin="4,24,0,8" />
                <Border Style="{StaticResource SpCardStyle}">
                    <VerticalStackLayout Spacing="12">
                        <Border BackgroundColor="{StaticResource SpCardHi}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="4">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                            <Border x:Name="PersonalOption" Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="0,11">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetPersonalCommand}" Tapped="OnOptionTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="Personal" HorizontalOptions="Center" FontFamily="SpaceGroteskMedium" FontSize="14" />
                            </Border>
                            <Border x:Name="CoachOption" Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="0,11">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetCoachCommand}" Tapped="OnOptionTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="Entrenador" HorizontalOptions="Center" FontFamily="SpaceGroteskMedium" FontSize="14" />
                            </Border>
                        </Grid>
                        </Border>
                        <Label Text="{Binding KindDescription}" Style="{StaticResource SpSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ── Vista: cuánto detalle, para los dos tipos ── -->
                <Label Text="Vista" Style="{StaticResource SpOverline}" Margin="4,24,0,8" />
                <Border Style="{StaticResource SpCardStyle}">
                    <VerticalStackLayout Spacing="12">
                        <Border BackgroundColor="{StaticResource SpCardHi}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="4">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                            <Border x:Name="SimpleOption" Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="0,11">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetSimpleCommand}" Tapped="OnOptionTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="Simple" HorizontalOptions="Center" FontFamily="SpaceGroteskMedium" FontSize="14" />
                            </Border>
                            <Border x:Name="DetailedOption" Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="0,11">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetDetailedCommand}" Tapped="OnOptionTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="Detallada" HorizontalOptions="Center" FontFamily="SpaceGroteskMedium" FontSize="14" />
                            </Border>
                        </Grid>
                        </Border>
                        <Label Text="{Binding ModeDescription}" Style="{StaticResource SpSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ── Bloques de la vista simple ── -->
                <Label Text="Mostrar también en vista simple" Style="{StaticResource SpOverline}" Margin="4,24,0,8" />
                <Border Style="{StaticResource SpCardStyle}" Padding="16,4">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsDetailed}" Value="True">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Border.Triggers>
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Intensidad" Style="{StaticResource SpBody}" />
                                <Label Text="RPE / RIR y % de 1RM" Style="{StaticResource SpSecondary}" FontSize="12" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding ShowIntensity}" OnColor="{StaticResource SpOk}" ThumbColor="{StaticResource SpText}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource SpLine}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Tempo y descanso" Style="{StaticResource SpBody}" />
                                <Label Text="Tempo y descanso entre series" Style="{StaticResource SpSecondary}" FontSize="12" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding ShowTempoAndRest}" OnColor="{StaticResource SpOk}" ThumbColor="{StaticResource SpText}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource SpLine}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Estructura avanzada" Style="{StaticResource SpBody}" />
                                <Label Text="Superseries y series de calentamiento" Style="{StaticResource SpSecondary}" FontSize="12" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding ShowAdvancedStructure}" OnColor="{StaticResource SpOk}" ThumbColor="{StaticResource SpText}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource SpLine}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Rangos de repeticiones" Style="{StaticResource SpBody}" />
                                <Label Text="8–12 en lugar de un número fijo" Style="{StaticResource SpSecondary}" FontSize="12" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding ShowRepRanges}" OnColor="{StaticResource SpOk}" ThumbColor="{StaticResource SpText}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource SpLine}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Notas detalladas" Style="{StaticResource SpBody}" />
                                <Label Text="Apuntar una nota en cada serie del entreno" Style="{StaticResource SpSecondary}" FontSize="12" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding ShowDetailedNotes}" OnColor="{StaticResource SpOk}" ThumbColor="{StaticResource SpText}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Label Text="En vista detallada todas las opciones están siempre visibles."
                       Style="{StaticResource SpSecondary}" FontSize="12" Margin="4,8,0,0"
                       IsVisible="{Binding IsDetailed}" />

                <!-- ── Tu gimnasio: discos que hay y peso de la barra (para enseñar cómo cargarla) ── -->
                <Label Text="Tu gimnasio" Style="{StaticResource SpOverline}" Margin="4,24,0,4" />
                <Label Text="Los discos que hay, para calcular cómo cargar la barra" Style="{StaticResource SpSecondary}" FontSize="12" Margin="4,0,0,10" />
                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Plates}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlateOption">
                            <Border HeightRequest="40" Padding="10,0" Margin="0,0,8,8"
                                    BackgroundColor="{StaticResource SpCardHi}" StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                    Stroke="{StaticResource SpText4}" StrokeDashArray="3,3">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsAvailable}" Value="False">
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                        <Setter Property="StrokeThickness" Value="1.5" />
                                        <Setter Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=TogglePlateCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <BoxView WidthRequest="8" CornerRadius="2" VerticalOptions="Center"
                                             HeightRequest="{Binding Weight, Converter={StaticResource PlateHeight}, ConverterParameter=22}"
                                             Color="{Binding Weight, Converter={StaticResource PlateColor}}" />
                                    <Label Text="{Binding Label}" FontFamily="SpaceGroteskBold" FontSize="14" TextColor="{StaticResource SpText}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
                <Border Style="{StaticResource SpCardStyle}" Padding="16,6" Margin="0,4,0,0">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                        <Label Text="Peso de la barra" Style="{StaticResource SpBody}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="−" Style="{StaticResource SpSecondaryButton}" Padding="0" WidthRequest="40" HeightRequest="40" MinimumHeightRequest="40"
                                Command="{Binding ChangeBarWeightCommand}" CommandParameter="-" />
                        <Label Grid.Column="2" Text="{Binding BarWeightText}" FontFamily="SpaceGroteskBold" FontSize="16" TextColor="{StaticResource SpText}"
                               MinimumWidthRequest="64" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                        <Button Grid.Column="3" Text="+" Style="{StaticResource SpSecondaryButton}" Padding="0" WidthRequest="40" HeightRequest="40" MinimumHeightRequest="40"
                                Command="{Binding ChangeBarWeightCommand}" CommandParameter="+" />
                    </Grid>
                </Border>

                <!-- ── Cambiar de perfil: de vuelta a «¿Quién entrena hoy?» ── -->
                <Button Text="Cambiar de perfil" Style="{StaticResource SpSecondaryButton}" Margin="0,32,0,0"
                        Command="{Binding SwitchProfileCommand}" />
                <Label Text="Vuelves a la pantalla de perfiles. No se borra nada." Style="{StaticResource SpSecondary}" FontSize="12"
                       HorizontalTextAlignment="Center" Margin="0,8,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
