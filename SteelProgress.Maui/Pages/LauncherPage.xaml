<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SteelProgress.Maui.Pages.LauncherPage"
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:SteelProgress.Maui.Converters"
    BackgroundColor="#14161E"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Esta página se crea antes que los recursos de App (App la recibe en su
                 constructor): los tokens se cargan aquí o los StaticResource revientan al arrancar. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:InitialLetterConverter x:Key="InitialConverter" />
            <conv:StringNotNullOrEmptyConverter x:Key="StringNotEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Row 0: el logo (el dibujo del icono) y el nombre -->
        <HorizontalStackLayout
            x:Name="HeaderSection"
            Grid.Row="0"
            Opacity="0"
            Spacing="10"
            Margin="20,40,20,0">
            <Image
                Source="logo_marca.png"
                WidthRequest="34"
                HeightRequest="34"
                Aspect="AspectFit"
                VerticalOptions="Center" />
            <Label
                Text="SteelProgress"
                FontFamily="SpaceGroteskMedium"
                FontSize="17"
                TextColor="{StaticResource SpText}"
                VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- Row 1: «¿Quién entrena hoy?» es el título de la pantalla -->
        <Label
            x:Name="SubtitleLabel"
            Grid.Row="1"
            Opacity="0"
            Text="{Binding SubtitleText}"
            Style="{StaticResource SpTitle}"
            Margin="20,32,20,0" />

        <!-- Row 2: Content -->
        <Grid Grid.Row="2">

            <!-- Loading spinner -->
            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                Color="#A6E3A1"
                WidthRequest="48"
                HeightRequest="48"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <!-- Startup error (persistent: an alert would be dismissed and leave a blank page) -->
            <VerticalStackLayout
                IsVisible="{Binding HasError}"
                VerticalOptions="Center"
                Spacing="10"
                Padding="32,0">
                <Label
                    Text="No se pudo iniciar"
                    FontSize="17"
                    FontAttributes="Bold"
                    TextColor="#EF8A8A"
                    HorizontalTextAlignment="Center" />
                <Label
                    Text="{Binding ErrorMessage}"
                    FontSize="13"
                    TextColor="#C6CBDA"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Lista de perfiles (cargada, sin error y sin estar creando uno) -->
            <Grid
                x:Name="ProfilesSection"
                IsVisible="{Binding CanShowProfiles}"
                RowDefinitions="*,Auto"
                Opacity="0">

                <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="8" Padding="20,20,20,8">

                        <!-- Filas de perfil (se construyen en el code-behind): tocar = entrar; ⋯ = editar o eliminar -->
                        <VerticalStackLayout
                            x:Name="ProfileList"
                            IsVisible="{Binding HasProfiles}"
                            Spacing="8" />

                        <!-- Añadir perfil: mismo ancho que las filas -->
                        <Border
                            IsVisible="{Binding CanAddProfile}"
                            BackgroundColor="Transparent"
                            Stroke="{StaticResource SpText4}"
                            StrokeThickness="1.5"
                            StrokeDashArray="4,3"
                            StrokeShape="RoundRectangle 14"
                            MinimumHeightRequest="56"
                            Margin="0,4,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding StartCreatingCommand}" />
                            </Border.GestureRecognizers>
                            <Label
                                Text="＋ Añadir perfil"
                                FontFamily="SpaceGroteskMedium"
                                FontSize="15"
                                TextColor="#C6CBDA"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>

                <Label
                    Grid.Row="1"
                    Text="Sin cuentas. Tus datos se quedan en este móvil."
                    Style="{StaticResource SpSecondary}"
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    Margin="20,8,20,24" />
            </Grid>

            <!-- Creation form (full height) -->
            <Grid
                IsVisible="{Binding IsCreating}"
                RowDefinitions="*,Auto,Auto,Auto,Auto"
                VerticalOptions="Fill">

                <!-- Row 0: Avatar + descripción live preview -->
                <VerticalStackLayout
                    Grid.Row="0"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="18">

                    <!-- Avatar con halo -->
                    <Grid HorizontalOptions="Center">
                        <Border
                            x:Name="AvatarHalo"
                            BackgroundColor="{Binding SelectedColor}"
                            WidthRequest="136"
                            HeightRequest="136"
                            Opacity="0.18"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 68"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                        <Border
                            x:Name="AvatarBorder"
                            BackgroundColor="{Binding SelectedColor}"
                            WidthRequest="112"
                            HeightRequest="112"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 56"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Label
                                x:Name="AvatarInitialLabel"
                                Text="{Binding NewProfileName, Converter={StaticResource InitialConverter}}"
                                TextColor="#14161E"
                                FontSize="36"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Descripción: preview en tiempo real entre comillas -->
                    <Label
                        x:Name="DescriptionPreview"
                        Text="{Binding DescriptionPreviewText}"
                        FontSize="14"
                        FontAttributes="Italic"
                        TextColor="#4A5064"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        MaxLines="3"
                        LineBreakMode="WordWrap"
                        Padding="8,0"
                        Margin="24,0">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HasDescription}" Value="True">
                                <Setter Property="TextColor" Value="#C6CBDA" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                </VerticalStackLayout>

                <!-- Row 1: Nombre (floating label) -->
                <Grid
                    x:Name="EntryContainer"
                    Grid.Row="1"
                    HeightRequest="68"
                    Margin="32,0">
                    <Entry
                        x:Name="NameEntry"
                        Text="{Binding NewProfileName}"
                        TextColor="#E8EAF2"
                        BackgroundColor="Transparent"
                        FontSize="18"
                        ReturnType="Next"
                        VerticalOptions="End"
                        Margin="0,24,0,4" />
                    <Label
                        x:Name="FloatingLabel"
                        Text="Nombre"
                        TextColor="#8A91A8"
                        FontSize="18"
                        AnchorX="0"
                        AnchorY="0.5"
                        VerticalOptions="Start"
                        HorizontalOptions="Start"
                        TranslationY="22" />
                    <BoxView
                        BackgroundColor="#4A5064"
                        HeightRequest="1"
                        VerticalOptions="End"
                        HorizontalOptions="Fill" />
                    <BoxView
                        x:Name="BottomLineActive"
                        BackgroundColor="#A6E3A1"
                        HeightRequest="2"
                        ScaleX="0"
                        AnchorX="0"
                        VerticalOptions="End"
                        HorizontalOptions="Fill" />
                </Grid>

                <!-- Row 2: Frase (floating label, opcional) -->
                <Grid
                    x:Name="FraseContainer"
                    Grid.Row="2"
                    HeightRequest="68"
                    Margin="32,12,32,0">
                    <Entry
                        x:Name="FraseEntry"
                        Text="{Binding NewProfileDescription}"
                        TextColor="#E8EAF2"
                        BackgroundColor="Transparent"
                        FontSize="16"
                        MaxLength="55"
                        ReturnType="Done"
                        ReturnCommand="{Binding CreateProfileCommand}"
                        VerticalOptions="End"
                        Margin="0,24,0,4" />
                    <Label
                        x:Name="FraseLabel"
                        Text="Frase (opcional)"
                        TextColor="#8A91A8"
                        FontSize="16"
                        AnchorX="0"
                        AnchorY="0.5"
                        VerticalOptions="Start"
                        HorizontalOptions="Start"
                        TranslationY="22" />
                    <BoxView
                        BackgroundColor="#4A5064"
                        HeightRequest="1"
                        VerticalOptions="End"
                        HorizontalOptions="Fill" />
                    <BoxView
                        x:Name="FraseLineActive"
                        BackgroundColor="#A6E3A1"
                        HeightRequest="2"
                        ScaleX="0"
                        AnchorX="0"
                        VerticalOptions="End"
                        HorizontalOptions="Fill" />
                </Grid>

                <!-- Row 3: Color picker -->
                <VerticalStackLayout
                    Grid.Row="3"
                    Spacing="10"
                    Margin="0,20,0,0">
                    <Label
                        Text="COLOR"
                        TextColor="#8A91A8"
                        FontSize="11"
                        FontAttributes="Bold"
                        CharacterSpacing="2"
                        HorizontalOptions="Center" />
                    <ScrollView
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout
                            x:Name="ColorPickerContainer"
                            Spacing="8"
                            Padding="20,0"
                            HorizontalOptions="Center" />
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Row 4: Action buttons -->
                <VerticalStackLayout
                    Grid.Row="4"
                    Margin="24,12,24,32"
                    Spacing="10">
                    <Button
                        IsVisible="{Binding IsFirstTimeSetup}"
                        Text="Empezar"
                        BackgroundColor="#A6E3A1"
                        TextColor="#14161E"
                        FontAttributes="Bold"
                        FontSize="16"
                        HeightRequest="52"
                        CornerRadius="12"
                        Command="{Binding CreateProfileCommand}" />
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10"
                        IsVisible="{Binding HasProfiles}">
                        <Button
                            Grid.Column="0"
                            Text="Cancelar"
                            BackgroundColor="#1B1E28"
                            TextColor="#E8EAF2"
                            FontSize="15"
                            HeightRequest="50"
                            CornerRadius="10"
                            BorderColor="#4A5064"
                            BorderWidth="1"
                            Command="{Binding CancelCreatingCommand}" />
                        <Button
                            Grid.Column="1"
                            Text="Crear"
                            BackgroundColor="#A6E3A1"
                            TextColor="#14161E"
                            FontAttributes="Bold"
                            FontSize="15"
                            HeightRequest="50"
                            CornerRadius="10"
                            Command="{Binding CreateProfileCommand}" />
                    </Grid>
                </VerticalStackLayout>

            </Grid>

        </Grid>

        <!-- Profile selection overlay — last child renders on top of everything -->
        <Grid
            x:Name="ProfileOverlay"
            Grid.RowSpan="3"
            IsVisible="False">

            <!-- Backdrop: tap to dismiss -->
            <BoxView
                x:Name="OverlayBackdrop"
                BackgroundColor="#14161E"
                Opacity="0">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOverlayBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Card panel: blocks backdrop tap from leaking through -->
            <Border
                x:Name="OverlayPanel"
                BackgroundColor="#1B1E28"
                StrokeShape="RoundRectangle 24"
                StrokeThickness="1"
                Stroke="#4A5064"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                Margin="20,0"
                Padding="28,28"
                Opacity="0"
                Scale="0.85">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOverlayPanelTapped" />
                </Border.GestureRecognizers>

                <!-- Wrapper: only one panel visible at a time -->
                <Grid>

                    <!-- VIEW content -->
                    <VerticalStackLayout x:Name="OverlayViewContent" Spacing="16">

                        <Border
                            x:Name="OverlayAvatar"
                            WidthRequest="120"
                            HeightRequest="120"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 60"
                            HorizontalOptions="Center">
                            <Label
                                x:Name="OverlayInitial"
                                TextColor="#14161E"
                                FontSize="44"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <Label
                            x:Name="OverlayName"
                            TextColor="#E8EAF2"
                            FontSize="20"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center" />

                        <Label
                            x:Name="OverlayDescription"
                            TextColor="#C6CBDA"
                            FontSize="13"
                            FontAttributes="Italic"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap"
                            MaxLines="2"
                            IsVisible="False"
                            Padding="8,0"
                            Margin="0,-6,0,0" />

                        <!-- Entrar es tocar la fila; aquí solo quedan las opciones del perfil -->
                        <VerticalStackLayout Spacing="10" Margin="0,8,0,0">
                            <Border
                                BackgroundColor="#2A2E3C"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="#9DB4E6"
                                Padding="0,13">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOverlayEditarTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="Editar" TextColor="#9DB4E6" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                            </Border>
                            <Border
                                BackgroundColor="#2A2E3C"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="#EF8A8A"
                                Padding="0,13">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOverlayEliminarTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="Eliminar" TextColor="#EF8A8A" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>

                    <!-- EDIT content (hidden by default) -->
                    <VerticalStackLayout x:Name="OverlayEditContent" Spacing="14" IsVisible="False">

                        <!-- Avatar reacts to color picker selection -->
                        <Border
                            x:Name="OverlayEditAvatar"
                            WidthRequest="96"
                            HeightRequest="96"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 48"
                            HorizontalOptions="Center">
                            <Label
                                x:Name="OverlayEditInitial"
                                TextColor="#14161E"
                                FontSize="34"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <!-- Name entry -->
                        <Grid HeightRequest="52" Margin="0,4,0,0">
                            <Entry
                                x:Name="OverlayEditNameEntry"
                                Text="{Binding EditingName, Mode=TwoWay}"
                                Placeholder="Nombre"
                                PlaceholderColor="#8A91A8"
                                TextColor="#E8EAF2"
                                BackgroundColor="Transparent"
                                FontSize="16"
                                MaxLength="30"
                                ReturnType="Next"
                                VerticalOptions="End"
                                Margin="0,0,0,8" />
                            <BoxView
                                BackgroundColor="#4A5064"
                                HeightRequest="1"
                                VerticalOptions="End"
                                HorizontalOptions="Fill" />
                            <BoxView
                                x:Name="OverlayEditNameLineActive"
                                BackgroundColor="#A6E3A1"
                                HeightRequest="1.5"
                                ScaleX="0"
                                AnchorX="0"
                                VerticalOptions="End"
                                HorizontalOptions="Fill" />
                        </Grid>

                        <!-- Description entry -->
                        <Grid HeightRequest="52" Margin="0,4,0,0">
                            <Entry
                                x:Name="OverlayEditDescEntry"
                                Text="{Binding EditingDescription, Mode=TwoWay}"
                                Placeholder="Frase corta (opcional)"
                                PlaceholderColor="#8A91A8"
                                TextColor="#E8EAF2"
                                BackgroundColor="Transparent"
                                FontSize="15"
                                MaxLength="55"
                                ReturnType="Done"
                                VerticalOptions="End"
                                Margin="0,0,0,8" />
                            <BoxView
                                BackgroundColor="#4A5064"
                                HeightRequest="1"
                                VerticalOptions="End"
                                HorizontalOptions="Fill" />
                            <BoxView
                                x:Name="OverlayEditDescLineActive"
                                BackgroundColor="#A6E3A1"
                                HeightRequest="1.5"
                                ScaleX="0"
                                AnchorX="0"
                                VerticalOptions="End"
                                HorizontalOptions="Fill" />
                        </Grid>

                        <!-- Color picker (built programmatically) -->
                        <ScrollView
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            Margin="0,6">
                            <HorizontalStackLayout
                                x:Name="OverlayEditColorPicker"
                                Spacing="4"
                                HorizontalOptions="Center" />
                        </ScrollView>

                        <!-- Cancelar / Guardar -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                            <Border
                                Grid.Column="0"
                                BackgroundColor="#2A2E3C"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="#4A5064"
                                Padding="0,13">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOverlayCancelarTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="Cancelar" TextColor="#C6CBDA" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" />
                            </Border>
                            <Border
                                Grid.Column="1"
                                BackgroundColor="#A6E3A1"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0"
                                Padding="0,13">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOverlayGuardarTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="Guardar" TextColor="#14161E" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" />
                            </Border>
                        </Grid>

                    </VerticalStackLayout>

                </Grid>
            </Border>

        </Grid>

    </Grid>

</ContentPage>
