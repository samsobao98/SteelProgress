<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SteelProgress.Maui.Pages.LauncherPage"
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:SteelProgress.Maui.Converters"
    BackgroundColor="#1E1E2E"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <conv:InitialLetterConverter x:Key="InitialConverter" />
        <conv:StringNotNullOrEmptyConverter x:Key="StringNotEmptyConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Animated background orbs -->
        <Ellipse
            x:Name="Orb1"
            Grid.RowSpan="3"
            Fill="#A6E3A1"
            HeightRequest="320"
            WidthRequest="320"
            HorizontalOptions="End"
            VerticalOptions="Start"
            Opacity="0.07"
            Margin="0,-100,-100,0" />
        <Ellipse
            x:Name="Orb2"
            Grid.RowSpan="3"
            Fill="#89B4FA"
            HeightRequest="220"
            WidthRequest="220"
            HorizontalOptions="Start"
            VerticalOptions="End"
            Opacity="0.06"
            Margin="-60,0,0,-60" />
        <Ellipse
            x:Name="Orb3"
            Grid.RowSpan="3"
            Fill="#CBA6F7"
            HeightRequest="180"
            WidthRequest="180"
            HorizontalOptions="End"
            VerticalOptions="Center"
            Opacity="0.05"
            Margin="0,60,-50,0" />

        <!-- Row 0: Logo (Grid para poder superponer el aura) -->
        <Grid
            x:Name="HeaderSection"
            Grid.Row="0"
            Opacity="0"
            TranslationY="-30"
            Margin="0,56,0,0"
            HeightRequest="128"
            HorizontalOptions="Center"
            WidthRequest="300">
            <!-- Aura: elipse verde que se expande y desvanece en bucle -->
            <Ellipse
                x:Name="LogoAura"
                Fill="#A6E3A1"
                WidthRequest="128"
                HeightRequest="128"
                Opacity="0"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
            <!-- Logo con spring bounce en la entrada (el ancho del Grid manda: 500x165 → ~300x99) -->
            <Image
                x:Name="LogoImage"
                Source="logo_icon.png"
                HeightRequest="128"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Aspect="AspectFit" />
        </Grid>

        <!-- Row 1: Subtitle -->
        <Label
            x:Name="SubtitleLabel"
            Grid.Row="1"
            Opacity="0"
            Text="{Binding SubtitleText}"
            FontSize="15"
            FontAttributes="Bold"
            TextColor="#BAC2DE"
            HorizontalTextAlignment="Center"
            Margin="0,14,0,0" />

        <!-- Row 2: Content -->
        <Grid Grid.Row="2">

            <!-- Loading spinner -->
            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                Color="#A6E3A1"
                WidthRequest="48"
                HeightRequest="48"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <!-- Profile list (shown when loaded and not creating) -->
            <VerticalStackLayout
                IsVisible="{Binding IsNotCreating}"
                VerticalOptions="Start"
                Spacing="28"
                Margin="0,24,0,24">

                <!-- Carousel (built programmatically in code-behind) -->
                <Grid
                    x:Name="CarouselContainer"
                    IsVisible="{Binding HasProfiles}"
                    HeightRequest="162"
                    IsClippedToBounds="False"
                    Margin="0,-20,0,0" />

                <!-- Add profile -->
                <Label
                    IsVisible="{Binding CanAddProfile}"
                    Text="＋ Añadir perfil"
                    TextColor="#6C7086"
                    FontSize="14"
                    FontAttributes="Bold"
                    HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding StartCreatingCommand}" />
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>

            <!-- Creation form (full height) -->
            <Grid
                IsVisible="{Binding IsCreating}"
                RowDefinitions="*,Auto,Auto,Auto,Auto"
                VerticalOptions="Fill">

                <!-- Row 0: Avatar + descripción live preview -->
                <VerticalStackLayout
                    Grid.Row="0"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="18">

                    <!-- Avatar con halo -->
                    <Grid HorizontalOptions="Center">
                        <Border
                            x:Name="AvatarHalo"
                            BackgroundColor="{Binding SelectedColor}"
                            WidthRequest="136"
                            HeightRequest="136"
                            Opacity="0.18"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 68"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                        <Border
                            x:Name="AvatarBorder"
                            BackgroundColor="{Binding SelectedColor}"
                            WidthRequest="112"
                            HeightRequest="112"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 56"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Label
                                x:Name="AvatarInitialLabel"
                                Text="{Binding NewProfileName, Converter={StaticResource InitialConverter}}"
                                TextColor="#1E1E2E"
                                FontSize="36"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Descripción: preview en tiempo real entre comillas -->
                    <Label
                        x:Name="DescriptionPreview"
                        Text="{Binding DescriptionPreviewText}"
                        FontSize="14"
                        FontAttributes="Italic"
                        TextColor="#45475A"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        MaxLines="3"
                        LineBreakMode="WordWrap"
                        Padding="8,0"
                        Margin="24,0">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HasDescription}" Value="True">
                                <Setter Property="TextColor" Value="#BAC2DE" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                </VerticalStackLayout>

                <!-- Row 1: Nombre (floating label) -->
                <Grid
                    x:Name="EntryContainer"
                    Grid.Row="1"
                    HeightRequest="68"
                    Margin="32,0">
                    <Entry
                        x:Name="NameEntry"
                        Text="{Binding NewProfileName}"
                        TextColor="#CDD6F4"
                        BackgroundColor="Transparent"
                        FontSize="18"
                        ReturnType="Next"
                        VerticalOptions="End"
                        Margin="0,24,0,4" />
                    <Label
                        x:Name="FloatingLabel"
                        Text="Nombre"
                        TextColor="#6C7086"
                        FontSize="18"
                        AnchorX="0"
                        AnchorY="0.5"
                        VerticalOptions="Start"
                        HorizontalOptions="Start"
                        TranslationY="22" />
                    <BoxView
                        BackgroundColor="#45475A"
                        HeightRequest="1"
                        VerticalOptions="End"
                        HorizontalOptions="Fill" />
                    <BoxView
                        x:Name="BottomLineActive"
                        BackgroundColor="#A6E3A1"
                        HeightRequest="2"
                        ScaleX="0"
                        AnchorX="0"
                        VerticalOptions="End"
                        HorizontalOptions="Fill" />
                </Grid>

                <!-- Row 2: Frase (floating label, opcional) -->
                <Grid
                    x:Name="FraseContainer"
                    Grid.Row="2"
                    HeightRequest="68"
                    Margin="32,12,32,0">
                    <Entry
                        x:Name="FraseEntry"
                        Text="{Binding NewProfileDescription}"
                        TextColor="#CDD6F4"
                        BackgroundColor="Transparent"
                        FontSize="16"
                        MaxLength="55"
                        ReturnType="Done"
                        ReturnCommand="{Binding CreateProfileCommand}"
                        VerticalOptions="End"
                        Margin="0,24,0,4" />
                    <Label
                        x:Name="FraseLabel"
                        Text="Frase (opcional)"
                        TextColor="#6C7086"
                        FontSize="16"
                        AnchorX="0"
                        AnchorY="0.5"
                        VerticalOptions="Start"
                        HorizontalOptions="Start"
                        TranslationY="22" />
                    <BoxView
                        BackgroundColor="#45475A"
                        HeightRequest="1"
                        VerticalOptions="End"
                        HorizontalOptions="Fill" />
                    <BoxView
                        x:Name="FraseLineActive"
                        BackgroundColor="#A6E3A1"
                        HeightRequest="2"
                        ScaleX="0"
                        AnchorX="0"
                        VerticalOptions="End"
                        HorizontalOptions="Fill" />
                </Grid>

                <!-- Row 3: Color picker -->
                <VerticalStackLayout
                    Grid.Row="3"
                    Spacing="10"
                    Margin="0,20,0,0">
                    <Label
                        Text="COLOR"
                        TextColor="#6C7086"
                        FontSize="11"
                        FontAttributes="Bold"
                        CharacterSpacing="2"
                        HorizontalOptions="Center" />
                    <ScrollView
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout
                            x:Name="ColorPickerContainer"
                            Spacing="8"
                            Padding="20,0"
                            HorizontalOptions="Center" />
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Row 4: Action buttons -->
                <VerticalStackLayout
                    Grid.Row="4"
                    Margin="24,12,24,32"
                    Spacing="10">
                    <Button
                        IsVisible="{Binding IsFirstTimeSetup}"
                        Text="Empezar"
                        BackgroundColor="#A6E3A1"
                        TextColor="#1E1E2E"
                        FontAttributes="Bold"
                        FontSize="16"
                        HeightRequest="52"
                        CornerRadius="12"
                        Command="{Binding CreateProfileCommand}" />
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10"
                        IsVisible="{Binding HasProfiles}">
                        <Button
                            Grid.Column="0"
                            Text="Cancelar"
                            BackgroundColor="#252536"
                            TextColor="#CDD6F4"
                            FontSize="15"
                            HeightRequest="50"
                            CornerRadius="10"
                            BorderColor="#45475A"
                            BorderWidth="1"
                            Command="{Binding CancelCreatingCommand}" />
                        <Button
                            Grid.Column="1"
                            Text="Crear"
                            BackgroundColor="#A6E3A1"
                            TextColor="#1E1E2E"
                            FontAttributes="Bold"
                            FontSize="15"
                            HeightRequest="50"
                            CornerRadius="10"
                            Command="{Binding CreateProfileCommand}" />
                    </Grid>
                </VerticalStackLayout>

            </Grid>

        </Grid>

        <!-- Profile selection overlay — last child renders on top of everything -->
        <Grid
            x:Name="ProfileOverlay"
            Grid.RowSpan="3"
            IsVisible="False">

            <!-- Backdrop: tap to dismiss -->
            <BoxView
                x:Name="OverlayBackdrop"
                BackgroundColor="#1E1E2E"
                Opacity="0">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOverlayBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Card panel: blocks backdrop tap from leaking through -->
            <Border
                x:Name="OverlayPanel"
                BackgroundColor="#252536"
                StrokeShape="RoundRectangle 24"
                StrokeThickness="1"
                Stroke="#45475A"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                Margin="20,0"
                Padding="28,28"
                Opacity="0"
                Scale="0.85">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOverlayPanelTapped" />
                </Border.GestureRecognizers>

                <!-- Wrapper: only one panel visible at a time -->
                <Grid>

                    <!-- VIEW content -->
                    <VerticalStackLayout x:Name="OverlayViewContent" Spacing="16">

                        <Border
                            x:Name="OverlayAvatar"
                            WidthRequest="120"
                            HeightRequest="120"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 60"
                            HorizontalOptions="Center">
                            <Label
                                x:Name="OverlayInitial"
                                TextColor="#1E1E2E"
                                FontSize="44"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <Label
                            x:Name="OverlayName"
                            TextColor="#CDD6F4"
                            FontSize="20"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center" />

                        <Label
                            x:Name="OverlayDescription"
                            TextColor="#BAC2DE"
                            FontSize="13"
                            FontAttributes="Italic"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap"
                            MaxLines="2"
                            IsVisible="False"
                            Padding="8,0"
                            Margin="0,-6,0,0" />

                        <VerticalStackLayout Spacing="10" Margin="0,8,0,0">
                            <Border
                                BackgroundColor="#A6E3A1"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0"
                                Padding="0,13">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOverlayEntrarTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="Entrar" TextColor="#1E1E2E" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                            </Border>
                            <Border
                                BackgroundColor="#313244"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="#89B4FA"
                                Padding="0,13">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOverlayEditarTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="Editar" TextColor="#89B4FA" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                            </Border>
                            <Border
                                BackgroundColor="#313244"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="#F38BA8"
                                Padding="0,13">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOverlayEliminarTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="Eliminar" TextColor="#F38BA8" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>

                    <!-- EDIT content (hidden by default) -->
                    <VerticalStackLayout x:Name="OverlayEditContent" Spacing="14" IsVisible="False">

                        <!-- Avatar reacts to color picker selection -->
                        <Border
                            x:Name="OverlayEditAvatar"
                            WidthRequest="96"
                            HeightRequest="96"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 48"
                            HorizontalOptions="Center">
                            <Label
                                x:Name="OverlayEditInitial"
                                TextColor="#1E1E2E"
                                FontSize="34"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <!-- Name entry -->
                        <Grid HeightRequest="52" Margin="0,4,0,0">
                            <Entry
                                x:Name="OverlayEditNameEntry"
                                Text="{Binding EditingName, Mode=TwoWay}"
                                Placeholder="Nombre"
                                PlaceholderColor="#6C7086"
                                TextColor="#CDD6F4"
                                BackgroundColor="Transparent"
                                FontSize="16"
                                MaxLength="30"
                                ReturnType="Next"
                                VerticalOptions="End"
                                Margin="0,0,0,8" />
                            <BoxView
                                BackgroundColor="#45475A"
                                HeightRequest="1"
                                VerticalOptions="End"
                                HorizontalOptions="Fill" />
                            <BoxView
                                x:Name="OverlayEditNameLineActive"
                                BackgroundColor="#A6E3A1"
                                HeightRequest="1.5"
                                ScaleX="0"
                                AnchorX="0"
                                VerticalOptions="End"
                                HorizontalOptions="Fill" />
                        </Grid>

                        <!-- Description entry -->
                        <Grid HeightRequest="52" Margin="0,4,0,0">
                            <Entry
                                x:Name="OverlayEditDescEntry"
                                Text="{Binding EditingDescription, Mode=TwoWay}"
                                Placeholder="Frase corta (opcional)"
                                PlaceholderColor="#6C7086"
                                TextColor="#CDD6F4"
                                BackgroundColor="Transparent"
                                FontSize="15"
                                MaxLength="55"
                                ReturnType="Done"
                                VerticalOptions="End"
                                Margin="0,0,0,8" />
                            <BoxView
                                BackgroundColor="#45475A"
                                HeightRequest="1"
                                VerticalOptions="End"
                                HorizontalOptions="Fill" />
                            <BoxView
                                x:Name="OverlayEditDescLineActive"
                                BackgroundColor="#A6E3A1"
                                HeightRequest="1.5"
                                ScaleX="0"
                                AnchorX="0"
                                VerticalOptions="End"
                                HorizontalOptions="Fill" />
                        </Grid>

                        <!-- Color picker (built programmatically) -->
                        <ScrollView
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            Margin="0,6">
                            <HorizontalStackLayout
                                x:Name="OverlayEditColorPicker"
                                Spacing="4"
                                HorizontalOptions="Center" />
                        </ScrollView>

                        <!-- Cancelar / Guardar -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                            <Border
                                Grid.Column="0"
                                BackgroundColor="#313244"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="#45475A"
                                Padding="0,13">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOverlayCancelarTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="Cancelar" TextColor="#BAC2DE" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" />
                            </Border>
                            <Border
                                Grid.Column="1"
                                BackgroundColor="#A6E3A1"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0"
                                Padding="0,13">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOverlayGuardarTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="Guardar" TextColor="#1E1E2E" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" />
                            </Border>
                        </Grid>

                    </VerticalStackLayout>

                </Grid>
            </Border>

        </Grid>

    </Grid>

</ContentPage>
