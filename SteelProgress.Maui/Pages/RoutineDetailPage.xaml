<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SteelProgress.Maui.Pages.RoutineDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:converters="clr-namespace:SteelProgress.Maui.Converters;assembly=SteelProgress.Maui"
    BackgroundColor="{StaticResource SpBg}"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <converters:PrescriptionTextConverter x:Key="PrescriptionText" />
        <converters:StringNotNullOrEmptyConverter x:Key="NotEmpty" />
        <converters:RoutineRowLabelConverter x:Key="RowLabel" />
        <converters:ExerciseThumbnailConverter x:Key="ExerciseThumb" />
        <converters:InvertedBoolConverter x:Key="Not" />
        <converters:IsNullConverter x:Key="IsNull" />

        <Style x:Key="IconButton" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource SpCard}" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="WidthRequest" Value="40" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="SheetField" TargetType="Border" BasedOn="{StaticResource SpCardStyle}">
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="SheetPrimary" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SpSteelBrush}" />
            <Setter Property="Padding" Value="0,16" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="StrokeThickness" Value="0" />
        </Style>
        <Style x:Key="SheetPrimaryLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="SpaceGroteskMedium" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="{StaticResource SpOnAccent}" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid>

        <!-- Orb decorativo -->
        <AbsoluteLayout InputTransparent="True" IsClippedToBounds="True">
            <Ellipse
                AbsoluteLayout.LayoutBounds="0, 0, 240, 240"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                Fill="#C9B9F2"
                Opacity="0.05" />
        </AbsoluteLayout>

        <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- ── Barra: volver + compartir + editar ── -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="14,14,14,0">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center" Padding="6,8">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="‹" FontSize="24" TextColor="{StaticResource SpText2}" VerticalOptions="Center" />
                    <Label Text="Rutinas" Style="{StaticResource SpBody}" FontSize="14" TextColor="{StaticResource SpText2}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <!-- Compartir la rutina como archivo .steel -->
                <Border x:Name="ShareButton" Grid.Column="1" Style="{StaticResource IconButton}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnShareTapped" />
                    </Border.GestureRecognizers>
                    <mi:MauiIcon Icon="{mi:Material Share}" IconColor="{StaticResource SpText}" IconSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Border Grid.Column="2" Style="{StaticResource IconButton}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEditRoutineTapped" />
                    </Border.GestureRecognizers>
                    <mi:MauiIcon Icon="{mi:Material Edit}" IconColor="{StaticResource SpText}" IconSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- ── Título ── -->
            <VerticalStackLayout Grid.Row="1" Padding="20,4,20,0">
                <Label Text="{Binding RoutineName}" Style="{StaticResource SpTitle}" LineBreakMode="TailTruncation" />
                <Label Text="{Binding SubtitleText}" Style="{StaticResource SpSecondary}" />
                <!-- Elegir esta como rutina activa (o quitar la marca) -->
                <Border x:Name="MarkActiveButton" HorizontalOptions="Start" Margin="0,10,0,0" Padding="12,6" StrokeShape="RoundRectangle 10"
                        BackgroundColor="{StaticResource SpCard}" StrokeThickness="1" Stroke="#2A2E3C">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsMarkedActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="#29B3B7EC" />
                            <Setter Property="StrokeThickness" Value="0" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMarkActiveTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding MarkActiveText}" FontFamily="SpaceGroteskMedium" FontSize="12" TextColor="{StaticResource SpSteel2}" />
                </Border>
            </VerticalStackLayout>

            <!-- ── Chips de días ── -->
            <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="20,16,20,12">
                <HorizontalStackLayout x:Name="DayChipsContainer" Spacing="8" />
            </ScrollView>

            <!-- ── Lista de ejercicios del día (reordenable) ── -->
            <CollectionView
                x:Name="ExerciseList"
                Grid.Row="3"
                ItemsSource="{Binding DayExercises}"
                CanReorderItems="True"
                ReorderCompleted="OnReorderCompleted"
                Margin="20,0,20,0">
                <CollectionView.Footer>
                    <BoxView HeightRequest="96" Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="0,50" Spacing="14" HorizontalOptions="Center">
                        <mi:MauiIcon Icon="{mi:Material FitnessCenter}" IconColor="{StaticResource SpCardHi}" IconSize="48" HorizontalOptions="Center" />
                        <Label x:Name="EmptyLabel" HorizontalTextAlignment="Center" Text="Sin ejercicios en este día" Style="{StaticResource SpBody}" TextColor="{StaticResource SpText3}" />
                        <Label HorizontalTextAlignment="Center" Text="Toca + para añadir el primero" Style="{StaticResource SpSecondary}" TextColor="{StaticResource SpText4}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,0,0,8">
                            <Border Style="{StaticResource SpCardStyle}" Padding="14,12">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                    <!-- Superserie (A1) o posición -->
                                    <Label Grid.Column="0" Text="{Binding ., Converter={StaticResource RowLabel}}" FontFamily="SpaceGroteskBold" FontSize="15"
                                           TextColor="{StaticResource SpSteel2}" WidthRequest="26" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding Exercise.Name}" FontFamily="SpaceGroteskMedium" FontSize="15" TextColor="{StaticResource SpText}" LineBreakMode="TailTruncation" />
                                        <!-- Lo prescrito: "4 × 6–8 · RPE 8 · 1:30" -->
                                        <Label Text="{Binding ., Converter={StaticResource PrescriptionText}}" FontFamily="SpaceGroteskMedium" FontSize="13" TextColor="{StaticResource SpText3}"
                                               IsVisible="{Binding ., Converter={StaticResource PrescriptionText}, ConverterParameter=visible}" />
                                        <!-- Sin objetivo: en Entreno no sabría cuándo está hecho -->
                                        <Label Text="+ Añadir series y reps" FontFamily="SpaceGroteskMedium" FontSize="13" TextColor="{StaticResource SpSteel2}"
                                               IsVisible="{Binding TargetSets, Converter={StaticResource IsNull}}">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnAddTargetsTapped" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </VerticalStackLayout>
                                    <!-- Handle de arrastre -->
                                    <mi:MauiIcon Grid.Column="2" Icon="{mi:Material DragHandle}" IconColor="{StaticResource SpText4}" IconSize="22" VerticalOptions="Center" />
                                    <!-- Menú ⋮ -->
                                    <Border Grid.Column="3" BackgroundColor="Transparent" HeightRequest="36" WidthRequest="30" StrokeThickness="0" VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnExerciseMenuTapped" />
                                        </Border.GestureRecognizers>
                                        <mi:MauiIcon Icon="{mi:Material MoreVert}" IconColor="{StaticResource SpText3}" IconSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

        <!-- ── FAB: añadir ejercicio ── -->
        <!-- Sin animar: Scale/Opacity sobre un elemento con Shadow deja la sombra borrosa en Android -->
        <Border
            x:Name="FabButton"
            Background="{StaticResource SpSteelBrush}"
            HeightRequest="58"
            WidthRequest="58"
            StrokeShape="RoundRectangle 18"
            StrokeThickness="0"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,20,24"
            Shadow="{Shadow Brush='#B3B7EC', Offset='0,6', Radius=14, Opacity=0.35}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAddExerciseTapped" />
            </Border.GestureRecognizers>
            <mi:MauiIcon Icon="{mi:Material Add}" IconColor="{StaticResource SpOnAccent}" IconSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>

        <!-- ── Overlay backdrop compartido ── -->
        <BoxView
            x:Name="OverlayBackdrop"
            BackgroundColor="#0A0A10"
            Opacity="0"
            IsVisible="False"
            InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackdropTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- ── Sheet: añadir ejercicios (buscador, grupos y selección múltiple) ── -->
        <Border
            x:Name="AddExerciseSheet"
            Style="{StaticResource SpSheetStyle}"
            VerticalOptions="End"
            HeightRequest="640"
            TranslationY="800"
            IsVisible="False">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="12">
                <BoxView HeightRequest="4" WidthRequest="40" Color="{StaticResource SpText4}" CornerRadius="2" HorizontalOptions="Center" />
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                    <Label Text="{Binding AddSheetTitle}" Style="{StaticResource SpHeading}" FontSize="18" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                    <Border Grid.Column="1" BackgroundColor="{StaticResource SpCardHi}" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseSheetTapped" />
                        </Border.GestureRecognizers>
                        <mi:MauiIcon Icon="{mi:Material Close}" IconColor="{StaticResource SpText3}" IconSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>
                <Border Grid.Row="2" BackgroundColor="{StaticResource SpBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,2">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <mi:MauiIcon Icon="{mi:Material Search}" IconColor="{StaticResource SpText3}" IconSize="20" VerticalOptions="Center" />
                        <Entry x:Name="SearchEntry" Grid.Column="1" Text="{Binding Picker.SearchText}" Placeholder="Buscar ejercicio…" FontSize="15"
                               TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText3}" BackgroundColor="Transparent" />
                    </Grid>
                </Border>
                <ScrollView Grid.Row="3" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="GroupChipsContainer" Spacing="6" />
                </ScrollView>
                <CollectionView Grid.Row="4" ItemsSource="{Binding Picker.Items}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="Ningún ejercicio coincide" Style="{StaticResource SpSecondary}" HorizontalOptions="Center" Margin="0,24" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPickerItemTapped" />
                                </Grid.GestureRecognizers>
                                <Border WidthRequest="46" HeightRequest="46" StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource SpCardHi}">
                                    <Grid>
                                        <Image Source="{Binding Exercise, Converter={StaticResource ExerciseThumb}}" Aspect="AspectFill" />
                                        <Label Text="▶" FontSize="14" TextColor="{StaticResource SpText3}" HorizontalOptions="Center" VerticalOptions="Center"
                                               IsVisible="{Binding Exercise, Converter={StaticResource ExerciseThumb}, ConverterParameter=video}" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontFamily="SpaceGroteskMedium" FontSize="15" TextColor="{StaticResource SpText}" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Detail}" Style="{StaticResource SpSecondary}" FontSize="12" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <!-- + sin elegir, ✓ elegido -->
                                <Border Grid.Column="2" WidthRequest="30" HeightRequest="30" StrokeThickness="0" StrokeShape="RoundRectangle 15" VerticalOptions="Center"
                                        Background="{StaticResource SpSteelBrush}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#33A6E3A1" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="+" FontFamily="SpaceGroteskBold" FontSize="16" TextColor="{StaticResource SpOnAccent}" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Text" Value="✓" />
                                                <Setter Property="TextColor" Value="{StaticResource SpOk}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Border Grid.Row="5" Style="{StaticResource SheetPrimary}" Opacity="0.45">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding Picker.HasSelection}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnConfirmAddExerciseTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding Picker.ConfirmText}" Style="{StaticResource SheetPrimaryLabel}" />
                </Border>
            </Grid>
        </Border>

        <!-- ── Sheet: nuevo día ── -->
        <Border
            x:Name="AddDaySheet"
            Style="{StaticResource SpSheetStyle}"
            VerticalOptions="End"
            TranslationY="700"
            IsVisible="False">
            <VerticalStackLayout Spacing="16" Padding="0,0,0,8">
                <BoxView HeightRequest="4" WidthRequest="40" Color="{StaticResource SpText4}" CornerRadius="2" HorizontalOptions="Center" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Label Text="Nuevo día" Style="{StaticResource SpHeading}" FontSize="20" VerticalOptions="Center" />
                    <Border Grid.Column="1" BackgroundColor="{StaticResource SpCardHi}" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseSheetTapped" />
                        </Border.GestureRecognizers>
                        <mi:MauiIcon Icon="{mi:Material Close}" IconColor="{StaticResource SpText3}" IconSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Border Style="{StaticResource SheetField}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nombre del día" Style="{StaticResource SpOverline}" />
                        <Entry x:Name="DayNameEntry" Text="{Binding NewDayName}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}"
                               Placeholder="ej. Empuje" BackgroundColor="Transparent" FontSize="15" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource SheetPrimary}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnConfirmAddDayTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="Añadir día" Style="{StaticResource SheetPrimaryLabel}" />
                </Border>
            </VerticalStackLayout>
        </Border>

        <!-- ── Sheet: editar rutina ── -->
        <Border
            x:Name="EditRoutineSheet"
            Style="{StaticResource SpSheetStyle}"
            VerticalOptions="End"
            TranslationY="700"
            IsVisible="False">
            <VerticalStackLayout Spacing="16" Padding="0,0,0,8">
                <BoxView HeightRequest="4" WidthRequest="40" Color="{StaticResource SpText4}" CornerRadius="2" HorizontalOptions="Center" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Label Text="Editar rutina" Style="{StaticResource SpHeading}" FontSize="20" VerticalOptions="Center" />
                    <Border Grid.Column="1" BackgroundColor="{StaticResource SpCardHi}" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseSheetTapped" />
                        </Border.GestureRecognizers>
                        <mi:MauiIcon Icon="{mi:Material Close}" IconColor="{StaticResource SpText3}" IconSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Border Style="{StaticResource SheetField}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nombre" Style="{StaticResource SpOverline}" />
                        <Entry x:Name="EditNameEntry" Text="{Binding RoutineName}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}"
                               BackgroundColor="Transparent" FontSize="15" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource SheetField}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Notas (opcional)" Style="{StaticResource SpOverline}" />
                        <Entry x:Name="EditNotesEntry" Text="{Binding RoutineNotes}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}"
                               Placeholder="Objetivo, frecuencia..." BackgroundColor="Transparent" FontSize="15" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource SheetPrimary}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSaveRoutineTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="Guardar" Style="{StaticResource SheetPrimaryLabel}" />
                </Border>

                <Border BackgroundColor="Transparent" Padding="0,12" StrokeShape="RoundRectangle 14" StrokeThickness="1" Stroke="#EF8A8A">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDeleteRoutineTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="Eliminar rutina" FontFamily="SpaceGroteskMedium" FontSize="15" TextColor="{StaticResource SpDanger}" HorizontalOptions="Center" />
                </Border>
            </VerticalStackLayout>
        </Border>

        <!-- ===== PANEL: EDITAR PRESCRIPCIÓN (sistema de diseño) ===== -->
        <Grid IsVisible="{Binding Editor.IsOpen}" BackgroundColor="#8C0A0A10">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding Editor.CloseCommand}" />
            </Grid.GestureRecognizers>

            <Border Style="{StaticResource SpSheetStyle}" VerticalOptions="End" MaximumHeightRequest="640">
                <!-- Tocar dentro del panel no lo cierra -->
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <ScrollView>
                    <VerticalStackLayout Spacing="14">
                        <BoxView HeightRequest="4" WidthRequest="40" CornerRadius="2" Color="{StaticResource SpText4}" HorizontalOptions="Center" />
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Editor.ExerciseName}" Style="{StaticResource SpHeading}" />
                            <Label Text="Vacío = sin indicar" Style="{StaticResource SpSecondary}" FontSize="12" />
                        </VerticalStackLayout>

                        <!-- Básico: siempre -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Series" Style="{StaticResource SpSecondary}" FontSize="12" />
                                <Entry Text="{Binding Editor.Sets}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" FontFamily="SpaceGroteskBold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Reps" Style="{StaticResource SpSecondary}" FontSize="12" />
                                <Entry Text="{Binding Editor.Reps}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" FontFamily="SpaceGroteskBold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4" IsVisible="{Binding Editor.ShowRepRange}">
                                <Label Text="Hasta (rango)" Style="{StaticResource SpSecondary}" FontSize="12" />
                                <Entry Text="{Binding Editor.RepsMax}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" FontFamily="SpaceGroteskBold" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Intensidad -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding Editor.ShowIntensity}">
                            <Label Text="Intensidad" Style="{StaticResource SpOverline}" TextColor="{StaticResource SpIntensity}" />
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Peso kg" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.Weight}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="% 1RM" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.Percent1RM}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="4">
                                    <Label Text="RPE" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.Rpe}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="3" Spacing="4">
                                    <Label Text="RIR" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.Rir}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Tempo y descanso -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding Editor.ShowTempoAndRest}">
                            <Label Text="Tempo y descanso" Style="{StaticResource SpOverline}" TextColor="{StaticResource SpRest}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Tempo (3-1-1-0)" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.Tempo}" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Descanso (segundos)" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.RestSeconds}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Estructura avanzada -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding Editor.ShowStructure}">
                            <Label Text="Estructura" Style="{StaticResource SpOverline}" TextColor="{StaticResource SpSteel2}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Superserie (A1, A2…)" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.GroupLabel}" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Series de calentamiento" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.WarmupSets}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Notas: siempre -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Notas" Style="{StaticResource SpSecondary}" FontSize="12" />
                            <Editor Text="{Binding Editor.Notes}" AutoSize="TextChanges" Placeholder="Indicaciones para este ejercicio" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                        </VerticalStackLayout>

                        <Label Text="{Binding Editor.Error}" TextColor="{StaticResource SpDanger}" FontSize="13" IsVisible="{Binding Editor.Error, Converter={StaticResource NotEmpty}}" />

                        <Grid ColumnDefinitions="*,2*" ColumnSpacing="8">
                            <Button Text="Cancelar" Style="{StaticResource SpSecondaryButton}" Command="{Binding Editor.CloseCommand}" />
                            <Button Grid.Column="1" Text="Guardar" Style="{StaticResource SpPrimaryButton}" Command="{Binding Editor.SaveCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
