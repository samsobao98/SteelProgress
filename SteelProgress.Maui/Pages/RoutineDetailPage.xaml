<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SteelProgress.Maui.Pages.RoutineDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:converters="clr-namespace:SteelProgress.Maui.Converters;assembly=SteelProgress.Maui"
    BackgroundColor="#1E1E2E"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <converters:MuscleGroupColorConverter x:Key="MuscleGroupColor" />
        <converters:PrescriptionTextConverter x:Key="PrescriptionText" />
        <converters:StringNotNullOrEmptyConverter x:Key="NotEmpty" />
    </ContentPage.Resources>

    <Grid>

        <!-- Orb decorativo -->
        <AbsoluteLayout InputTransparent="True" IsClippedToBounds="True">
            <Ellipse
                AbsoluteLayout.LayoutBounds="0, 0, 240, 240"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                Fill="#CBA6F7"
                Opacity="0.05" />
        </AbsoluteLayout>

        <Grid RowDefinitions="Auto,Auto,*">

            <!-- ── Header: volver + nombre + compartir + editar ── -->
            <Grid
                Grid.Row="0"
                ColumnDefinitions="Auto,*,Auto,Auto"
                ColumnSpacing="10"
                Padding="14,18,14,8">
                <Border
                    Grid.Column="0"
                    BackgroundColor="#252536"
                    HeightRequest="40"
                    WidthRequest="40"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <mi:MauiIcon
                        Icon="{mi:Material ArrowBack}"
                        IconColor="#CDD6F4"
                        IconSize="22"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
                <Label
                    Grid.Column="1"
                    Text="{Binding RoutineName}"
                    FontAttributes="Bold"
                    FontSize="22"
                    TextColor="#CDD6F4"
                    LineBreakMode="TailTruncation"
                    VerticalOptions="Center" />
                <!-- Compartir la rutina como archivo .steel -->
                <Border
                    x:Name="ShareButton"
                    Grid.Column="2"
                    BackgroundColor="#252536"
                    HeightRequest="40"
                    WidthRequest="40"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnShareTapped" />
                    </Border.GestureRecognizers>
                    <mi:MauiIcon
                        Icon="{mi:Material Share}"
                        IconColor="#CDD6F4"
                        IconSize="20"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
                <Border
                    Grid.Column="3"
                    BackgroundColor="#252536"
                    HeightRequest="40"
                    WidthRequest="40"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEditRoutineTapped" />
                    </Border.GestureRecognizers>
                    <mi:MauiIcon
                        Icon="{mi:Material Edit}"
                        IconColor="#CDD6F4"
                        IconSize="20"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- ── Chips de días ── -->
            <ScrollView
                Grid.Row="1"
                Orientation="Horizontal"
                HorizontalScrollBarVisibility="Never"
                Padding="14,4,14,12">
                <HorizontalStackLayout x:Name="DayChipsContainer" Spacing="8" />
            </ScrollView>

            <!-- ── Lista de ejercicios del día (reordenable) ── -->
            <CollectionView
                x:Name="ExerciseList"
                Grid.Row="2"
                ItemsSource="{Binding DayExercises}"
                CanReorderItems="True"
                ReorderCompleted="OnReorderCompleted"
                Margin="14,0,14,0">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="0,50" Spacing="14" HorizontalOptions="Center">
                        <mi:MauiIcon
                            Icon="{mi:Material FitnessCenter}"
                            IconColor="#313244"
                            IconSize="48"
                            HorizontalOptions="Center" />
                        <Label
                            x:Name="EmptyLabel"
                            HorizontalTextAlignment="Center"
                            Text="Sin ejercicios en este día"
                            TextColor="#585B70"
                            FontSize="15" />
                        <Label
                            HorizontalTextAlignment="Center"
                            Text="Toca + para añadir el primero"
                            TextColor="#45475A"
                            FontSize="13" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,0,0,10">
                            <Border
                                BackgroundColor="#252536"
                                Padding="14,12"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="0">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <!-- Handle de arrastre -->
                                    <mi:MauiIcon
                                        Grid.Column="0"
                                        Icon="{mi:Material DragHandle}"
                                        IconColor="#45475A"
                                        IconSize="22"
                                        VerticalOptions="Center" />
                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="6"
                                        VerticalOptions="Center">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="15"
                                            Text="{Binding Exercise.Name}"
                                            TextColor="#CDD6F4"
                                            LineBreakMode="TailTruncation" />
                                        <!-- Lo prescrito: "4 × 6–8 · RPE 8 · 1:30" -->
                                        <Label
                                            FontFamily="SpaceGroteskMedium"
                                            FontSize="13"
                                            Text="{Binding ., Converter={StaticResource PrescriptionText}}"
                                            TextColor="{StaticResource SpOk}"
                                            IsVisible="{Binding ., Converter={StaticResource PrescriptionText}, ConverterParameter=visible}" />
                                        <Border
                                            BackgroundColor="{Binding Exercise.MuscleGroup, Converter={StaticResource MuscleGroupColor}}"
                                            Padding="9,3"
                                            StrokeShape="RoundRectangle 7"
                                            StrokeThickness="0"
                                            HorizontalOptions="Start">
                                            <Label
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                Text="{Binding Exercise.MuscleGroup}"
                                                TextColor="#1E1E2E" />
                                        </Border>
                                    </VerticalStackLayout>
                                    <!-- Menú ⋮ -->
                                    <Border
                                        Grid.Column="2"
                                        BackgroundColor="Transparent"
                                        HeightRequest="36"
                                        WidthRequest="30"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnExerciseMenuTapped" />
                                        </Border.GestureRecognizers>
                                        <mi:MauiIcon
                                            Icon="{mi:Material MoreVert}"
                                            IconColor="#6C7086"
                                            IconSize="20"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

        <!-- ── FAB: añadir ejercicio ── -->
        <Border
            x:Name="FabButton"
            BackgroundColor="#A6E3A1"
            HeightRequest="56"
            WidthRequest="56"
            StrokeShape="RoundRectangle 28"
            StrokeThickness="0"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,20,24"
            Shadow="{Shadow Brush='#A6E3A1', Offset='0,4', Radius=12, Opacity=0.35}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAddExerciseTapped" />
            </Border.GestureRecognizers>
            <mi:MauiIcon
                Icon="{mi:Material Add}"
                IconColor="#1E1E2E"
                IconSize="28"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Border>

        <!-- ── Overlay backdrop compartido ── -->
        <BoxView
            x:Name="OverlayBackdrop"
            BackgroundColor="#000000"
            Opacity="0"
            IsVisible="False"
            InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackdropTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- ── Sheet: añadir ejercicio ── -->
        <Border
            x:Name="AddExerciseSheet"
            BackgroundColor="#1E1E2E"
            StrokeShape="RoundRectangle 24,24,0,0"
            StrokeThickness="0"
            VerticalOptions="End"
            TranslationY="700"
            IsVisible="False">
            <VerticalStackLayout Padding="20,16,20,36" Spacing="16">
                <BoxView HeightRequest="4" WidthRequest="40" BackgroundColor="#45475A" CornerRadius="2" HorizontalOptions="Center" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Label FontAttributes="Bold" FontSize="20" Text="Añadir ejercicio" TextColor="#CDD6F4" VerticalOptions="Center" />
                    <Border Grid.Column="1" BackgroundColor="#313244" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseSheetTapped" />
                        </Border.GestureRecognizers>
                        <mi:MauiIcon Icon="{mi:Material Close}" IconColor="#6C7086" IconSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Border BackgroundColor="#252536" Padding="16,12" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                    <VerticalStackLayout Spacing="4">
                        <Label FontSize="11" Text="EJERCICIO" TextColor="#6C7086" CharacterSpacing="1" />
                        <Picker
                            ItemsSource="{Binding AllExercises}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedExerciseToAdd, Mode=TwoWay}"
                            Title="Seleccionar..."
                            TitleColor="#45475A"
                            TextColor="#CDD6F4"
                            BackgroundColor="Transparent"
                            FontSize="15" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" BackgroundColor="#252536" Padding="16,12" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                        <VerticalStackLayout Spacing="4">
                            <Label FontSize="11" Text="SERIES" TextColor="#6C7086" CharacterSpacing="1" />
                            <Entry
                                Text="{Binding NewSets}"
                                Keyboard="Numeric"
                                TextColor="#CDD6F4"
                                PlaceholderColor="#45475A"
                                Placeholder="4"
                                BackgroundColor="Transparent"
                                FontSize="15" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="#252536" Padding="16,12" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                        <VerticalStackLayout Spacing="4">
                            <Label FontSize="11" Text="REPS" TextColor="#6C7086" CharacterSpacing="1" />
                            <Entry
                                Text="{Binding NewReps}"
                                Keyboard="Numeric"
                                TextColor="#CDD6F4"
                                PlaceholderColor="#45475A"
                                Placeholder="8"
                                BackgroundColor="Transparent"
                                FontSize="15" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border BackgroundColor="#A6E3A1" Padding="0,16" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnConfirmAddExerciseTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="Añadir" FontAttributes="Bold" FontSize="16" TextColor="#1E1E2E" HorizontalOptions="Center" />
                </Border>
            </VerticalStackLayout>
        </Border>

        <!-- ── Sheet: nuevo día ── -->
        <Border
            x:Name="AddDaySheet"
            BackgroundColor="#1E1E2E"
            StrokeShape="RoundRectangle 24,24,0,0"
            StrokeThickness="0"
            VerticalOptions="End"
            TranslationY="700"
            IsVisible="False">
            <VerticalStackLayout Padding="20,16,20,36" Spacing="16">
                <BoxView HeightRequest="4" WidthRequest="40" BackgroundColor="#45475A" CornerRadius="2" HorizontalOptions="Center" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Label FontAttributes="Bold" FontSize="20" Text="Nuevo día" TextColor="#CDD6F4" VerticalOptions="Center" />
                    <Border Grid.Column="1" BackgroundColor="#313244" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseSheetTapped" />
                        </Border.GestureRecognizers>
                        <mi:MauiIcon Icon="{mi:Material Close}" IconColor="#6C7086" IconSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Border BackgroundColor="#252536" Padding="16,12" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                    <VerticalStackLayout Spacing="4">
                        <Label FontSize="11" Text="NOMBRE DEL DÍA" TextColor="#6C7086" CharacterSpacing="1" />
                        <Entry
                            x:Name="DayNameEntry"
                            Text="{Binding NewDayName}"
                            TextColor="#CDD6F4"
                            PlaceholderColor="#45475A"
                            Placeholder="ej. Empuje"
                            BackgroundColor="Transparent"
                            FontSize="15" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#A6E3A1" Padding="0,16" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnConfirmAddDayTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="Añadir día" FontAttributes="Bold" FontSize="16" TextColor="#1E1E2E" HorizontalOptions="Center" />
                </Border>
            </VerticalStackLayout>
        </Border>

        <!-- ── Sheet: editar rutina ── -->
        <Border
            x:Name="EditRoutineSheet"
            BackgroundColor="#1E1E2E"
            StrokeShape="RoundRectangle 24,24,0,0"
            StrokeThickness="0"
            VerticalOptions="End"
            TranslationY="700"
            IsVisible="False">
            <VerticalStackLayout Padding="20,16,20,36" Spacing="16">
                <BoxView HeightRequest="4" WidthRequest="40" BackgroundColor="#45475A" CornerRadius="2" HorizontalOptions="Center" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Label FontAttributes="Bold" FontSize="20" Text="Editar rutina" TextColor="#CDD6F4" VerticalOptions="Center" />
                    <Border Grid.Column="1" BackgroundColor="#313244" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseSheetTapped" />
                        </Border.GestureRecognizers>
                        <mi:MauiIcon Icon="{mi:Material Close}" IconColor="#6C7086" IconSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Border BackgroundColor="#252536" Padding="16,12" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                    <VerticalStackLayout Spacing="4">
                        <Label FontSize="11" Text="NOMBRE" TextColor="#6C7086" CharacterSpacing="1" />
                        <Entry
                            x:Name="EditNameEntry"
                            Text="{Binding RoutineName}"
                            TextColor="#CDD6F4"
                            PlaceholderColor="#45475A"
                            BackgroundColor="Transparent"
                            FontSize="15" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#252536" Padding="16,12" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                    <VerticalStackLayout Spacing="4">
                        <Label FontSize="11" Text="NOTAS (OPCIONAL)" TextColor="#6C7086" CharacterSpacing="1" />
                        <Entry
                            x:Name="EditNotesEntry"
                            Text="{Binding RoutineNotes}"
                            TextColor="#CDD6F4"
                            PlaceholderColor="#45475A"
                            Placeholder="Objetivo, frecuencia..."
                            BackgroundColor="Transparent"
                            FontSize="15" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#A6E3A1" Padding="0,16" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSaveRoutineTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="Guardar" FontAttributes="Bold" FontSize="16" TextColor="#1E1E2E" HorizontalOptions="Center" />
                </Border>

                <Border BackgroundColor="Transparent" Padding="0,12" StrokeShape="RoundRectangle 14" StrokeThickness="1" Stroke="#F38BA8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDeleteRoutineTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="Eliminar rutina" FontAttributes="Bold" FontSize="15" TextColor="#F38BA8" HorizontalOptions="Center" />
                </Border>
            </VerticalStackLayout>
        </Border>

        <!-- ===== PANEL: EDITAR PRESCRIPCIÓN (sistema de diseño) ===== -->
        <Grid IsVisible="{Binding Editor.IsOpen}" BackgroundColor="#8C0A0A10">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding Editor.CloseCommand}" />
            </Grid.GestureRecognizers>

            <Border Style="{StaticResource SpSheetStyle}" VerticalOptions="End" MaximumHeightRequest="640">
                <!-- Tocar dentro del panel no lo cierra -->
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <ScrollView>
                    <VerticalStackLayout Spacing="14">
                        <BoxView HeightRequest="4" WidthRequest="40" CornerRadius="2" Color="{StaticResource SpText4}" HorizontalOptions="Center" />
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Editor.ExerciseName}" Style="{StaticResource SpHeading}" />
                            <Label Text="Vacío = sin indicar" Style="{StaticResource SpSecondary}" FontSize="12" />
                        </VerticalStackLayout>

                        <!-- Básico: siempre -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Series" Style="{StaticResource SpSecondary}" FontSize="12" />
                                <Entry Text="{Binding Editor.Sets}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" FontFamily="SpaceGroteskBold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Reps" Style="{StaticResource SpSecondary}" FontSize="12" />
                                <Entry Text="{Binding Editor.Reps}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" FontFamily="SpaceGroteskBold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4" IsVisible="{Binding Editor.ShowRepRange}">
                                <Label Text="Hasta (rango)" Style="{StaticResource SpSecondary}" FontSize="12" />
                                <Entry Text="{Binding Editor.RepsMax}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" FontFamily="SpaceGroteskBold" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Intensidad -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding Editor.ShowIntensity}">
                            <Label Text="Intensidad" Style="{StaticResource SpOverline}" TextColor="{StaticResource SpIntensity}" />
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Peso kg" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.Weight}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="% 1RM" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.Percent1RM}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="4">
                                    <Label Text="RPE" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.Rpe}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="3" Spacing="4">
                                    <Label Text="RIR" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.Rir}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Tempo y descanso -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding Editor.ShowTempoAndRest}">
                            <Label Text="Tempo y descanso" Style="{StaticResource SpOverline}" TextColor="{StaticResource SpRest}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Tempo (3-1-1-0)" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.Tempo}" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Descanso (segundos)" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.RestSeconds}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Estructura avanzada -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding Editor.ShowStructure}">
                            <Label Text="Estructura" Style="{StaticResource SpOverline}" TextColor="{StaticResource SpSteel2}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Superserie (A1, A2…)" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.GroupLabel}" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Series de calentamiento" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.WarmupSets}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Notas: siempre -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Notas" Style="{StaticResource SpSecondary}" FontSize="12" />
                            <Editor Text="{Binding Editor.Notes}" AutoSize="TextChanges" Placeholder="Indicaciones para este ejercicio" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                        </VerticalStackLayout>

                        <Label Text="{Binding Editor.Error}" TextColor="{StaticResource SpDanger}" FontSize="13" IsVisible="{Binding Editor.Error, Converter={StaticResource NotEmpty}}" />

                        <Grid ColumnDefinitions="*,2*" ColumnSpacing="8">
                            <Button Text="Cancelar" Style="{StaticResource SpSecondaryButton}" Command="{Binding Editor.CloseCommand}" />
                            <Button Grid.Column="1" Text="Guardar" Style="{StaticResource SpPrimaryButton}" Command="{Binding Editor.SaveCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
