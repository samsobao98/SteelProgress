<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SteelProgress.Maui.Pages.ExercisePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:converters="clr-namespace:SteelProgress.Maui.Converters;assembly=SteelProgress.Maui"
    BackgroundColor="#1E1E2E"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <converters:MuscleGroupColorConverter x:Key="MuscleGroupColor" />
        <converters:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmpty" />
        <converters:InvertedBoolConverter x:Key="InvertedBool" />
        <converters:MediaImageSourceConverter x:Key="MediaImage" />
        <converters:MediaIsVideoConverter x:Key="MediaIsVideo" />
        <converters:ExerciseThumbnailConverter x:Key="ExerciseThumb" />
    </ContentPage.Resources>

    <Grid>

        <!-- Orb decorativo -->
        <AbsoluteLayout InputTransparent="True" IsClippedToBounds="True">
            <Ellipse
                AbsoluteLayout.LayoutBounds="1, 0, 260, 260"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                Fill="#89B4FA"
                Opacity="0.05" />
        </AbsoluteLayout>

        <!-- ── Contenido principal ── -->
        <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- Mini-header sin card — solo título + contador -->
            <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto"
                Padding="20,20,20,12">
                <Label
                    FontAttributes="Bold"
                    FontSize="26"
                    Text="Ejercicios"
                    TextColor="#CDD6F4"
                    VerticalOptions="Center" />
                <Border
                    Grid.Column="1"
                    BackgroundColor="#252536"
                    Padding="12,6"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                    <Label
                        FontSize="13"
                        FontAttributes="Bold"
                        Text="{Binding Exercises.Count}"
                        TextColor="#6C7086" />
                </Border>
            </Grid>

            <!-- Búsqueda -->
            <Border
                Grid.Row="1"
                BackgroundColor="#252536"
                Padding="14,2"
                Margin="20,0,20,10"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <mi:MauiIcon
                        Icon="{mi:Material Search}"
                        IconColor="#6C7086"
                        IconSize="20"
                        VerticalOptions="Center" />
                    <Entry
                        Grid.Column="1"
                        Text="{Binding SearchText, Mode=TwoWay}"
                        Placeholder="Buscar ejercicio..."
                        PlaceholderColor="#45475A"
                        TextColor="#CDD6F4"
                        BackgroundColor="Transparent"
                        FontSize="14"
                        ReturnType="Search" />
                </Grid>
            </Border>

            <!-- Chips de filtro por grupo muscular (construidos en code-behind) -->
            <ScrollView
                Grid.Row="2"
                Orientation="Horizontal"
                HorizontalScrollBarVisibility="Never"
                Margin="0,0,0,10">
                <HorizontalStackLayout
                    x:Name="GroupChipsContainer"
                    Spacing="8"
                    Padding="20,0" />
            </ScrollView>

            <!-- Lista de ejercicios -->
            <CollectionView
                x:Name="ExerciseList"
                Grid.Row="3"
                ItemsSource="{Binding Exercises}"
                Opacity="0"
                Margin="20,0,20,0">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="0,60" Spacing="14" HorizontalOptions="Center">
                        <mi:MauiIcon
                            Icon="{mi:Material FitnessCenter}"
                            IconColor="#313244"
                            IconSize="52"
                            HorizontalOptions="Center" />
                        <Label
                            HorizontalTextAlignment="Center"
                            Text="Sin resultados"
                            TextColor="#585B70"
                            FontSize="15" />
                        <Label
                            HorizontalTextAlignment="Center"
                            Text="Prueba otra búsqueda u otro filtro"
                            TextColor="#45475A"
                            FontSize="13" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,0,0,10">
                            <Border
                                BackgroundColor="#252536"
                                Padding="16,14"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnExerciseTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <!-- Miniatura del primer vídeo o imagen -->
                                    <Border
                                        WidthRequest="56"
                                        HeightRequest="56"
                                        BackgroundColor="{StaticResource SpCardHi}"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding ., Converter={StaticResource ExerciseThumb}, ConverterParameter=any}">
                                        <Grid>
                                            <Image Source="{Binding ., Converter={StaticResource ExerciseThumb}}" Aspect="AspectFill" />
                                            <Label Text="▶" FontSize="18" TextColor="{StaticResource SpText}" HorizontalOptions="Center" VerticalOptions="Center"
                                                   IsVisible="{Binding ., Converter={StaticResource ExerciseThumb}, ConverterParameter=video}" />
                                        </Grid>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="15"
                                            Text="{Binding Name}"
                                            TextColor="#CDD6F4"
                                            LineBreakMode="TailTruncation" />
                                        <!-- Chips: grupo muscular + badge "Propio" en los del usuario -->
                                        <HorizontalStackLayout Spacing="6">
                                            <Border
                                                BackgroundColor="{Binding MuscleGroup, Converter={StaticResource MuscleGroupColor}}"
                                                Padding="10,4"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0">
                                                <Label
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    Text="{Binding MuscleGroup}"
                                                    TextColor="#1E1E2E" />
                                            </Border>
                                            <Border
                                                BackgroundColor="Transparent"
                                                Padding="10,4"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="1"
                                                Stroke="#585B70"
                                                IsVisible="{Binding IsSystem, Converter={StaticResource InvertedBool}}">
                                                <Label
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    Text="Propio"
                                                    TextColor="#9399B2" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Label
                                            FontSize="12"
                                            Text="{Binding Equipment}"
                                            TextColor="#6C7086"
                                            IsVisible="{Binding Equipment, Converter={StaticResource StringNotNullOrEmpty}}" />
                                        <Label
                                            FontSize="12"
                                            Text="{Binding Notes}"
                                            TextColor="#6C7086"
                                            LineBreakMode="TailTruncation"
                                            IsVisible="{Binding Notes, Converter={StaticResource StringNotNullOrEmpty}}" />
                                    </VerticalStackLayout>
                                    <mi:MauiIcon
                                        Grid.Column="2"
                                        Icon="{mi:Material ChevronRight}"
                                        IconColor="#45475A"
                                        IconSize="20"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

        <!-- ── FAB ── -->
        <Border
            x:Name="FabButton"
            BackgroundColor="#A6E3A1"
            HeightRequest="56"
            WidthRequest="56"
            StrokeShape="RoundRectangle 28"
            StrokeThickness="0"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,20,24"
            Shadow="{Shadow Brush='#A6E3A1', Offset='0,4', Radius=12, Opacity=0.35}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnFabTapped" />
            </Border.GestureRecognizers>
            <mi:MauiIcon
                Icon="{mi:Material Add}"
                IconColor="#1E1E2E"
                IconSize="28"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Border>

        <!-- ── Overlay backdrop ── -->
        <BoxView
            x:Name="OverlayBackdrop"
            BackgroundColor="#000000"
            Opacity="0"
            IsVisible="False"
            InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackdropTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- ── Bottom sheet formulario ── -->
        <Border
            x:Name="BottomSheet"
            BackgroundColor="#1E1E2E"
            StrokeShape="RoundRectangle 24,24,0,0"
            StrokeThickness="0"
            VerticalOptions="End"
            TranslationY="700"
            IsVisible="False">
            <!-- Se desplaza si no cabe (MaximumHeightRequest, en código) -->
            <ScrollView x:Name="SheetScroll">
            <VerticalStackLayout Padding="20,16,20,36" Spacing="16">

                <!-- Handle -->
                <BoxView
                    HeightRequest="4"
                    WidthRequest="40"
                    BackgroundColor="#45475A"
                    CornerRadius="2"
                    HorizontalOptions="Center" />

                <!-- Header del sheet -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="{Binding OverlayTitle}"
                        TextColor="#CDD6F4"
                        VerticalOptions="Center" />
                    <Border
                        Grid.Column="1"
                        BackgroundColor="#313244"
                        HeightRequest="36"
                        WidthRequest="36"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseSheetTapped" />
                        </Border.GestureRecognizers>
                        <mi:MauiIcon
                            Icon="{mi:Material Close}"
                            IconColor="#6C7086"
                            IconSize="18"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Campo: Nombre -->
                <Border
                    BackgroundColor="#252536"
                    Padding="16,12"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="0">
                    <VerticalStackLayout Spacing="4">
                        <Label FontSize="11" Text="NOMBRE" TextColor="#6C7086" CharacterSpacing="1" />
                        <Entry
                            Text="{Binding Name}"
                            TextColor="#CDD6F4"
                            PlaceholderColor="#45475A"
                            Placeholder="ej. Press banca"
                            BackgroundColor="Transparent"
                            FontSize="15" />
                    </VerticalStackLayout>
                </Border>

                <!-- Campo: Grupo muscular (Picker) -->
                <Border
                    BackgroundColor="#252536"
                    Padding="16,12"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="0">
                    <VerticalStackLayout Spacing="4">
                        <Label FontSize="11" Text="GRUPO MUSCULAR" TextColor="#6C7086" CharacterSpacing="1" />
                        <Picker
                            ItemsSource="{Binding MuscleGroups}"
                            SelectedItem="{Binding MuscleGroup, Mode=TwoWay}"
                            Title="Seleccionar..."
                            TitleColor="#45475A"
                            TextColor="#CDD6F4"
                            BackgroundColor="Transparent"
                            FontSize="15" />
                    </VerticalStackLayout>
                </Border>

                <!-- Campo: Notas -->
                <Border
                    BackgroundColor="#252536"
                    Padding="16,12"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="0">
                    <VerticalStackLayout Spacing="4">
                        <Label FontSize="11" Text="NOTAS (OPCIONAL)" TextColor="#6C7086" CharacterSpacing="1" />
                        <Entry
                            Text="{Binding Notes}"
                            TextColor="#CDD6F4"
                            PlaceholderColor="#45475A"
                            Placeholder="Descripción, variantes..."
                            BackgroundColor="Transparent"
                            FontSize="15" />
                    </VerticalStackLayout>
                </Border>

                <!-- Material e instrucciones: vista entrenador -->
                <Border
                    BackgroundColor="#252536"
                    Padding="16,12"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="0"
                    IsVisible="{Binding ShowDetailFields}">
                    <VerticalStackLayout Spacing="4">
                        <Label FontSize="11" Text="MATERIAL (OPCIONAL)" TextColor="#6C7086" CharacterSpacing="1" />
                        <Entry
                            Text="{Binding Equipment}"
                            TextColor="#CDD6F4"
                            PlaceholderColor="#45475A"
                            Placeholder="ej. Barra, mancuernas, polea"
                            BackgroundColor="Transparent"
                            FontSize="15" />
                    </VerticalStackLayout>
                </Border>
                <Border
                    BackgroundColor="#252536"
                    Padding="16,12"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="0"
                    IsVisible="{Binding ShowDetailFields}">
                    <VerticalStackLayout Spacing="4">
                        <Label FontSize="11" Text="INSTRUCCIONES (OPCIONAL)" TextColor="#6C7086" CharacterSpacing="1" />
                        <Editor
                            Text="{Binding Instructions}"
                            TextColor="#CDD6F4"
                            PlaceholderColor="#45475A"
                            Placeholder="Cómo se ejecuta, puntos técnicos…"
                            BackgroundColor="Transparent"
                            AutoSize="TextChanges"
                            MaximumHeightRequest="120"
                            FontSize="15" />
                    </VerticalStackLayout>
                </Border>

                <!-- Vídeos e imágenes propios -->
                <Border
                    Style="{StaticResource SpCardStyle}"
                    Padding="16,12"
                    IsVisible="{Binding MediaEnabled}">
                    <VerticalStackLayout Spacing="10">
                        <Label FontSize="11" Text="VÍDEOS E IMÁGENES" TextColor="#6C7086" CharacterSpacing="1" />
                        <CollectionView ItemsSource="{Binding Media}" HeightRequest="84" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.EmptyView>
                                <Label Text="Añade un vídeo, GIF o foto de la galería para ver cómo se hace."
                                       Style="{StaticResource SpSecondary}" FontSize="12" VerticalOptions="Center" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid WidthRequest="84" HeightRequest="84">
                                        <Border BackgroundColor="{StaticResource SpCardHi}" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnMediaTapped" />
                                            </Border.GestureRecognizers>
                                            <Grid>
                                                <Image Source="{Binding ., Converter={StaticResource MediaImage}}" Aspect="AspectFill"
                                                       IsAnimationPlaying="{Binding ., Converter={StaticResource MediaIsVideo}, ConverterParameter=gif}" />
                                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2"
                                                                     IsVisible="{Binding ., Converter={StaticResource MediaIsVideo}}">
                                                    <Label Text="▶" FontSize="22" TextColor="{StaticResource SpText}" HorizontalOptions="Center" />
                                                    <Label Text="Vídeo" FontSize="10" TextColor="{StaticResource SpText3}" HorizontalOptions="Center" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                        <!-- Quitar -->
                                        <Border WidthRequest="24" HeightRequest="24" BackgroundColor="#CC161622"
                                                StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                                HorizontalOptions="End" VerticalOptions="Start" Margin="0,4,4,0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnRemoveMediaTapped" />
                                            </Border.GestureRecognizers>
                                            <Label Text="✕" FontSize="11" TextColor="{StaticResource SpText}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Button
                            x:Name="AddMediaButton"
                            Style="{StaticResource SpSecondaryButton}"
                            Padding="12,10"
                            Text="+ Añadir vídeo o imagen"
                            Clicked="OnAddMediaClicked" />
                        <ActivityIndicator IsRunning="{Binding IsImportingMedia}" IsVisible="{Binding IsImportingMedia}" Color="{StaticResource SpSteel2}" HeightRequest="24" />
                    </VerticalStackLayout>
                </Border>

                <!-- Botón primario: Añadir o Guardar -->
                <Border
                    BackgroundColor="{Binding IsEditMode, Converter={x:Static converters:EditModeColorConverter.Instance}}"
                    Padding="0,16"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSaveTapped" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="{Binding SaveButtonText}"
                        FontAttributes="Bold"
                        FontSize="16"
                        TextColor="#1E1E2E"
                        HorizontalOptions="Center" />
                </Border>

                <!-- Botón eliminar — solo en modo edición -->
                <Border
                    BackgroundColor="Transparent"
                    Padding="0,12"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="1"
                    Stroke="#F38BA8"
                    IsVisible="{Binding IsEditMode}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDeleteTapped" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="Eliminar ejercicio"
                        FontAttributes="Bold"
                        FontSize="15"
                        TextColor="#F38BA8"
                        HorizontalOptions="Center" />
                </Border>

            </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- ── Ficha de detalle (solo lectura) ── -->
        <Border
            x:Name="DetailSheet"
            BackgroundColor="#1E1E2E"
            StrokeShape="RoundRectangle 24,24,0,0"
            StrokeThickness="0"
            VerticalOptions="End"
            TranslationY="800"
            IsVisible="False">
            <VerticalStackLayout Padding="20,16,20,36" Spacing="14">

                <BoxView
                    HeightRequest="4"
                    WidthRequest="40"
                    BackgroundColor="#45475A"
                    CornerRadius="2"
                    HorizontalOptions="Center" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0" ColumnSpacing="12">
                    <Label
                        x:Name="DetailName"
                        FontAttributes="Bold"
                        FontSize="20"
                        TextColor="#CDD6F4"
                        LineBreakMode="WordWrap"
                        VerticalOptions="Center" />
                    <Border
                        Grid.Column="1"
                        BackgroundColor="#313244"
                        HeightRequest="36"
                        WidthRequest="36"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="0"
                        VerticalOptions="Start">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseDetailTapped" />
                        </Border.GestureRecognizers>
                        <mi:MauiIcon
                            Icon="{mi:Material Close}"
                            IconColor="#6C7086"
                            IconSize="18"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Chips: grupo + equipamiento -->
                <HorizontalStackLayout Spacing="6">
                    <Border
                        x:Name="DetailGroupChip"
                        Padding="10,4"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="0">
                        <Label
                            x:Name="DetailGroupLabel"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="#1E1E2E" />
                    </Border>
                    <Border
                        x:Name="DetailEquipmentChip"
                        BackgroundColor="#313244"
                        Padding="10,4"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="0">
                        <Label
                            x:Name="DetailEquipmentLabel"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="#BAC2DE" />
                    </Border>
                </HorizontalStackLayout>

                <!-- Músculos secundarios -->
                <VerticalStackLayout x:Name="DetailSecondarySection" Spacing="4">
                    <Label FontSize="11" Text="MÚSCULOS SECUNDARIOS" TextColor="#6C7086" CharacterSpacing="1" />
                    <Label
                        x:Name="DetailSecondaryLabel"
                        FontSize="14"
                        TextColor="#BAC2DE" />
                </VerticalStackLayout>

                <!-- Instrucciones -->
                <VerticalStackLayout x:Name="DetailInstructionsSection" Spacing="4">
                    <Label FontSize="11" Text="CÓMO SE HACE" TextColor="#6C7086" CharacterSpacing="1" />
                    <Label
                        x:Name="DetailInstructionsLabel"
                        FontSize="14"
                        TextColor="#CDD6F4"
                        LineHeight="1.3"
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <!-- Notas (solo propios) -->
                <VerticalStackLayout x:Name="DetailNotesSection" Spacing="4">
                    <Label FontSize="11" Text="NOTAS" TextColor="#6C7086" CharacterSpacing="1" />
                    <Label
                        x:Name="DetailNotesLabel"
                        FontSize="14"
                        TextColor="#BAC2DE"
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <!-- Editar — solo ejercicios propios -->
                <Border
                    x:Name="DetailEditButton"
                    BackgroundColor="#89B4FA"
                    Padding="0,14"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="0"
                    Margin="0,6,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDetailEditTapped" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="Editar ejercicio"
                        FontAttributes="Bold"
                        FontSize="15"
                        TextColor="#1E1E2E"
                        HorizontalOptions="Center" />
                </Border>

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
