<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SteelProgress.Maui.Pages.ExercisePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:converters="clr-namespace:SteelProgress.Maui.Converters;assembly=SteelProgress.Maui"
    xmlns:controls="clr-namespace:SteelProgress.Maui.Controls"
    BackgroundColor="#14161E"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <converters:MuscleGroupColorConverter x:Key="MuscleGroupColor" />
        <converters:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmpty" />
        <converters:InvertedBoolConverter x:Key="InvertedBool" />
        <converters:MediaImageSourceConverter x:Key="MediaImage" />
        <converters:MediaIsVideoConverter x:Key="MediaIsVideo" />
        <converters:ExerciseThumbnailConverter x:Key="ExerciseThumb" />
    </ContentPage.Resources>

    <Grid>

        <!-- Orb decorativo -->
        <AbsoluteLayout InputTransparent="True" IsClippedToBounds="True">
            <Ellipse
                AbsoluteLayout.LayoutBounds="1, 0, 260, 260"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                Fill="#9DB4E6"
                Opacity="0.05" />
        </AbsoluteLayout>

        <!-- ── Contenido principal ── -->
        <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- Cabecera: título y cuántos hay (todos y propios) -->
            <VerticalStackLayout Grid.Row="0" Padding="20,20,20,12">
                <Label Text="Ejercicios" Style="{StaticResource SpTitle}" />
                <Label Text="{Binding CountText}" Style="{StaticResource SpSecondary}" />
            </VerticalStackLayout>

            <!-- Búsqueda (nombre, grupo o etiqueta) -->
            <Border
                Grid.Row="1"
                BackgroundColor="{StaticResource SpCard}"
                Padding="14,2"
                Margin="20,0,20,10"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <mi:MauiIcon
                        Icon="{mi:Material Search}"
                        IconColor="{StaticResource SpText3}"
                        IconSize="20"
                        VerticalOptions="Center" />
                    <Entry
                        Grid.Column="1"
                        Text="{Binding SearchText, Mode=TwoWay}"
                        Placeholder="Buscar ejercicio..."
                        PlaceholderColor="{StaticResource SpText4}"
                        TextColor="{StaticResource SpText}"
                        BackgroundColor="Transparent"
                        FontSize="14"
                        ReturnType="Search" />
                </Grid>
            </Border>

            <!-- Chips: Todos, ★ Propios y los grupos musculares (construidos en code-behind) -->
            <ScrollView
                Grid.Row="2"
                Orientation="Horizontal"
                HorizontalScrollBarVisibility="Never"
                Margin="0,0,0,6">
                <HorizontalStackLayout
                    x:Name="GroupChipsContainer"
                    Spacing="8"
                    Padding="20,0" />
            </ScrollView>

            <!-- Lista por grupo muscular -->
            <CollectionView
                x:Name="ExerciseList"
                Grid.Row="3"
                ItemsSource="{Binding Groups}"
                IsGrouped="True"
                Opacity="0"
                Margin="20,0,20,0">
                <CollectionView.Footer>
                    <BoxView HeightRequest="96" Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="0,60" Spacing="14" HorizontalOptions="Center">
                        <mi:MauiIcon
                            Icon="{mi:Material FitnessCenter}"
                            IconColor="{StaticResource SpCardHi}"
                            IconSize="52"
                            HorizontalOptions="Center" />
                        <Label HorizontalTextAlignment="Center" Text="Sin resultados" Style="{StaticResource SpBody}" TextColor="{StaticResource SpText3}" />
                        <Label HorizontalTextAlignment="Center" Text="Prueba otra búsqueda u otro filtro" Style="{StaticResource SpSecondary}" TextColor="{StaticResource SpText4}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate>
                        <Label Text="{Binding Header}" Style="{StaticResource SpOverline}" Margin="2,12,0,8" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,0,0,8">
                            <Border
                                Style="{StaticResource SpCardStyle}"
                                Padding="10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnExerciseTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <!-- Miniatura: fotograma del vídeo con su duración, GIF o foto; sin nada, hueco punteado -->
                                    <controls:ExerciseThumb Exercise="{Binding Exercise}" WidthRequest="64" HeightRequest="64" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" Style="{StaticResource SpHeading}" FontSize="15" LineBreakMode="TailTruncation" />
                                        <Label FontSize="12" LineBreakMode="TailTruncation">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding DetailText}" TextColor="{StaticResource SpText3}" />
                                                    <Span Text="{Binding OriginSeparator}" TextColor="{StaticResource SpText3}" />
                                                    <Span Text="{Binding OriginText}" TextColor="{StaticResource SpSteel3}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <mi:MauiIcon
                                        Grid.Column="2"
                                        Icon="{mi:Material ChevronRight}"
                                        IconColor="{StaticResource SpText4}"
                                        IconSize="20"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

        <!-- ── FAB ── -->
        <!-- Sin animar: Scale/Opacity sobre un elemento con Shadow deja la sombra borrosa en Android -->
        <Border
            x:Name="FabButton"
            Background="{StaticResource SpSteelBrush}"
            HeightRequest="58"
            WidthRequest="58"
            StrokeShape="RoundRectangle 18"
            StrokeThickness="0"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,20,24"
            Shadow="{Shadow Brush='#B3B7EC', Offset='0,6', Radius=14, Opacity=0.35}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnFabTapped" />
            </Border.GestureRecognizers>
            <mi:MauiIcon
                Icon="{mi:Material Add}"
                IconColor="{StaticResource SpOnAccent}"
                IconSize="28"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Border>

        <!-- ── Overlay backdrop ── -->
        <BoxView
            x:Name="OverlayBackdrop"
            BackgroundColor="#000000"
            Opacity="0"
            IsVisible="False"
            InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackdropTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- ── Bottom sheet formulario ── -->
        <Border
            x:Name="BottomSheet"
            BackgroundColor="#14161E"
            StrokeShape="RoundRectangle 24,24,0,0"
            StrokeThickness="0"
            VerticalOptions="End"
            TranslationY="700"
            IsVisible="False">
            <!-- Se desplaza si no cabe (MaximumHeightRequest, en código) -->
            <ScrollView x:Name="SheetScroll">
            <VerticalStackLayout Padding="20,16,20,36" Spacing="16">

                <!-- Handle -->
                <BoxView
                    HeightRequest="4"
                    WidthRequest="40"
                    BackgroundColor="#4A5064"
                    CornerRadius="2"
                    HorizontalOptions="Center" />

                <!-- Header del sheet -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="{Binding OverlayTitle}"
                        TextColor="#E8EAF2"
                        VerticalOptions="Center" />
                    <Border
                        Grid.Column="1"
                        BackgroundColor="#2A2E3C"
                        HeightRequest="36"
                        WidthRequest="36"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseSheetTapped" />
                        </Border.GestureRecognizers>
                        <mi:MauiIcon
                            Icon="{mi:Material Close}"
                            IconColor="#8A91A8"
                            IconSize="18"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Lo primero, el vídeo: es lo que hace propio el ejercicio -->
                <Border
                    Style="{StaticResource SpCardStyle}"
                    Padding="16,12"
                    IsVisible="{Binding MediaEnabled}">
                    <VerticalStackLayout Spacing="10">
                        <Label FontSize="11" Text="VÍDEOS E IMÁGENES" TextColor="#8A91A8" CharacterSpacing="1" />
                        <CollectionView ItemsSource="{Binding Media}" HeightRequest="84" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.EmptyView>
                                <Label Text="Añade un vídeo, GIF o foto de la galería para ver cómo se hace."
                                       Style="{StaticResource SpSecondary}" FontSize="12" VerticalOptions="Center" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid WidthRequest="84" HeightRequest="84">
                                        <Border BackgroundColor="{StaticResource SpCardHi}" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnMediaTapped" />
                                            </Border.GestureRecognizers>
                                            <Grid>
                                                <Image Source="{Binding ., Converter={StaticResource MediaImage}}" Aspect="AspectFill"
                                                       IsAnimationPlaying="{Binding ., Converter={StaticResource MediaIsVideo}, ConverterParameter=gif}" />
                                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2"
                                                                     IsVisible="{Binding ., Converter={StaticResource MediaIsVideo}}">
                                                    <Label Text="▶" FontSize="22" TextColor="{StaticResource SpText}" HorizontalOptions="Center" />
                                                    <Label Text="Vídeo" FontSize="10" TextColor="{StaticResource SpText3}" HorizontalOptions="Center" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                        <!-- Quitar -->
                                        <Border WidthRequest="24" HeightRequest="24" BackgroundColor="#CC0F1117"
                                                StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                                HorizontalOptions="End" VerticalOptions="Start" Margin="0,4,4,0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnRemoveMediaTapped" />
                                            </Border.GestureRecognizers>
                                            <Label Text="✕" FontSize="11" TextColor="{StaticResource SpText}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Button
                            x:Name="AddMediaButton"
                            Style="{StaticResource SpSecondaryButton}"
                            Padding="12,10"
                            Text="+ Añadir vídeo o imagen"
                            Clicked="OnAddMediaClicked" />
                        <ActivityIndicator IsRunning="{Binding IsImportingMedia}" IsVisible="{Binding IsImportingMedia}" Color="{StaticResource SpSteel2}" HeightRequest="24" />
                    </VerticalStackLayout>
                </Border>

                <!-- Campo: Nombre -->
                <Border
                    BackgroundColor="#1B1E28"
                    Padding="16,12"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="0">
                    <VerticalStackLayout Spacing="4">
                        <Label FontSize="11" Text="NOMBRE" TextColor="#8A91A8" CharacterSpacing="1" />
                        <Entry
                            Text="{Binding Name}"
                            TextColor="#E8EAF2"
                            PlaceholderColor="#4A5064"
                            Placeholder="ej. Press banca"
                            BackgroundColor="Transparent"
                            FontSize="15" />
                    </VerticalStackLayout>
                </Border>

                <!-- Grupo muscular: chips (construidos en code-behind) -->
                <VerticalStackLayout Spacing="8">
                    <Label FontSize="11" Text="GRUPO MUSCULAR" TextColor="{StaticResource SpText3}" CharacterSpacing="1" />
                    <FlexLayout x:Name="FormGroupChips" Wrap="Wrap" AlignItems="Start" />
                </VerticalStackLayout>

                <!-- Con qué se hace: obligatorio, tarjetas con icono (construidas en code-behind) -->
                <VerticalStackLayout Spacing="8">
                    <Label FontSize="11" TextColor="{StaticResource SpText3}" CharacterSpacing="1">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="CON QUÉ SE HACE " />
                                <Span Text="(OBLIGATORIO)" TextColor="{StaticResource SpRecord}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Grid x:Name="EquipmentChips" ColumnDefinitions="*,*" ColumnSpacing="8" RowSpacing="8" />
                    <Border
                        BackgroundColor="#1B1E28"
                        Padding="16,12"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="0"
                        IsVisible="{Binding IsOtherEquipment}">
                        <VerticalStackLayout Spacing="4">
                            <Label FontSize="11" Text="¿CUÁL? (OPCIONAL)" TextColor="#8A91A8" CharacterSpacing="1" />
                            <Entry
                                Text="{Binding Equipment}"
                                TextColor="#E8EAF2"
                                PlaceholderColor="#4A5064"
                                Placeholder="ej. Gomas, TRX, balón medicinal"
                                BackgroundColor="Transparent"
                                FontSize="15" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Campo: Notas -->
                <Border
                    BackgroundColor="#1B1E28"
                    Padding="16,12"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="0">
                    <VerticalStackLayout Spacing="4">
                        <Label FontSize="11" Text="NOTAS (OPCIONAL)" TextColor="#8A91A8" CharacterSpacing="1" />
                        <Entry
                            Text="{Binding Notes}"
                            TextColor="#E8EAF2"
                            PlaceholderColor="#4A5064"
                            Placeholder="Descripción, variantes..."
                            BackgroundColor="Transparent"
                            FontSize="15" />
                    </VerticalStackLayout>
                </Border>

                <!-- Instrucciones y etiquetas: vista entrenador -->
                <Border
                    BackgroundColor="#1B1E28"
                    Padding="16,12"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="0"
                    IsVisible="{Binding ShowDetailFields}">
                    <VerticalStackLayout Spacing="4">
                        <Label FontSize="11" Text="INSTRUCCIONES (OPCIONAL)" TextColor="#8A91A8" CharacterSpacing="1" />
                        <Editor
                            Text="{Binding Instructions}"
                            TextColor="#E8EAF2"
                            PlaceholderColor="#4A5064"
                            Placeholder="Cómo se ejecuta, puntos técnicos…"
                            BackgroundColor="Transparent"
                            AutoSize="TextChanges"
                            MaximumHeightRequest="120"
                            FontSize="15" />
                    </VerticalStackLayout>
                </Border>
                <Border
                    BackgroundColor="#1B1E28"
                    Padding="16,12"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="0"
                    IsVisible="{Binding ShowDetailFields}">
                    <VerticalStackLayout Spacing="4">
                        <Label FontSize="11" Text="ETIQUETAS (OPCIONAL)" TextColor="#8A91A8" CharacterSpacing="1" />
                        <Entry
                            Text="{Binding Tags}"
                            TextColor="#E8EAF2"
                            PlaceholderColor="#4A5064"
                            Placeholder="Separadas por comas: unilateral, casa"
                            BackgroundColor="Transparent"
                            FontSize="15" />
                    </VerticalStackLayout>
                </Border>

                <!-- Botón primario: Añadir o Guardar -->
                <Border
                    BackgroundColor="{Binding IsEditMode, Converter={x:Static converters:EditModeColorConverter.Instance}}"
                    Padding="0,16"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSaveTapped" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="{Binding SaveButtonText}"
                        FontAttributes="Bold"
                        FontSize="16"
                        TextColor="#14161E"
                        HorizontalOptions="Center" />
                </Border>

                <!-- Botón eliminar — solo en modo edición -->
                <Border
                    BackgroundColor="Transparent"
                    Padding="0,12"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="1"
                    Stroke="#EF8A8A"
                    IsVisible="{Binding IsEditMode}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDeleteTapped" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="Eliminar ejercicio"
                        FontAttributes="Bold"
                        FontSize="15"
                        TextColor="#EF8A8A"
                        HorizontalOptions="Center" />
                </Border>

            </VerticalStackLayout>
            </ScrollView>
        </Border>

    </Grid>

</ContentPage>
