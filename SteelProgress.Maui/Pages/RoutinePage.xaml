<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SteelProgress.Maui.Pages.RoutinePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:converters="clr-namespace:SteelProgress.Maui.Converters;assembly=SteelProgress.Maui"
    xmlns:controls="clr-namespace:SteelProgress.Maui.Controls"
    BackgroundColor="#1E1E2E"
    Shell.NavBarIsVisible="False"
    Title="Rutinas">

    <ContentPage.Resources>
        <converters:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmpty" />
    </ContentPage.Resources>

    <Grid>

        <!-- Orb decorativo -->
        <AbsoluteLayout InputTransparent="True" IsClippedToBounds="True">
            <Ellipse
                AbsoluteLayout.LayoutBounds="1, 0, 260, 260"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                Fill="#CBA6F7"
                Opacity="0.05" />
        </AbsoluteLayout>

        <!-- ── Contenido principal ── -->
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- Mini-header: título + importar + contador -->
            <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="8"
                Padding="20,20,20,12">
                <Label
                    FontAttributes="Bold"
                    FontSize="26"
                    Text="Rutinas"
                    TextColor="#CDD6F4"
                    VerticalOptions="Center" />
                <!-- Importar una rutina compartida (.steel) -->
                <Border
                    Grid.Column="1"
                    BackgroundColor="#252536"
                    HeightRequest="36"
                    WidthRequest="36"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnImportTapped" />
                    </Border.GestureRecognizers>
                    <mi:MauiIcon
                        Icon="{mi:Material FileDownload}"
                        IconColor="#CDD6F4"
                        IconSize="20"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
                <Border
                    Grid.Column="2"
                    BackgroundColor="#252536"
                    Padding="12,6"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                    <Label
                        FontSize="13"
                        FontAttributes="Bold"
                        Text="{Binding Routines.Count}"
                        TextColor="#6C7086" />
                </Border>
            </Grid>

            <!-- Con un cliente activo, estas rutinas son las suyas -->
            <controls:ActiveClientBanner Grid.Row="1" Margin="20,0,20,12" />

            <!-- Lista de rutinas -->
            <CollectionView
                x:Name="RoutineList"
                Grid.Row="2"
                ItemsSource="{Binding Routines}"
                Opacity="0"
                Margin="20,0,20,0">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="0,60" Spacing="14" HorizontalOptions="Center">
                        <mi:MauiIcon
                            Icon="{mi:Material ListAlt}"
                            IconColor="#313244"
                            IconSize="52"
                            HorizontalOptions="Center" />
                        <Label
                            HorizontalTextAlignment="Center"
                            Text="Sin rutinas todavía"
                            TextColor="#585B70"
                            FontSize="15" />
                        <Label
                            HorizontalTextAlignment="Center"
                            Text="Toca + para crear la primera"
                            TextColor="#45475A"
                            FontSize="13" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,0,0,10">
                            <Border
                                BackgroundColor="#252536"
                                Padding="16,14"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRoutineTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <!-- Badge con inicial -->
                                    <Border
                                        Grid.Column="0"
                                        BackgroundColor="#CBA6F7"
                                        HeightRequest="46"
                                        WidthRequest="46"
                                        StrokeShape="RoundRectangle 14"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                        <Label
                                            Text="{Binding Initial}"
                                            FontAttributes="Bold"
                                            FontSize="20"
                                            TextColor="#1E1E2E"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="4"
                                        VerticalOptions="Center">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            Text="{Binding Name}"
                                            TextColor="#CDD6F4"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            FontSize="12"
                                            Text="{Binding SummaryText}"
                                            TextColor="#89B4FA" />
                                        <Label
                                            FontSize="12"
                                            Text="{Binding Notes}"
                                            TextColor="#6C7086"
                                            LineBreakMode="TailTruncation"
                                            IsVisible="{Binding Notes, Converter={StaticResource StringNotNullOrEmpty}}" />
                                    </VerticalStackLayout>
                                    <mi:MauiIcon
                                        Grid.Column="2"
                                        Icon="{mi:Material ChevronRight}"
                                        IconColor="#45475A"
                                        IconSize="20"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

        <!-- ── FAB ── -->
        <Border
            x:Name="FabButton"
            BackgroundColor="#A6E3A1"
            HeightRequest="56"
            WidthRequest="56"
            StrokeShape="RoundRectangle 28"
            StrokeThickness="0"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,20,24"
            Shadow="{Shadow Brush='#A6E3A1', Offset='0,4', Radius=12, Opacity=0.35}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnFabTapped" />
            </Border.GestureRecognizers>
            <mi:MauiIcon
                Icon="{mi:Material Add}"
                IconColor="#1E1E2E"
                IconSize="28"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Border>

        <!-- ── Overlay backdrop ── -->
        <BoxView
            x:Name="OverlayBackdrop"
            BackgroundColor="#000000"
            Opacity="0"
            IsVisible="False"
            InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackdropTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- ── Bottom sheet: nueva rutina ── -->
        <Border
            x:Name="BottomSheet"
            BackgroundColor="#1E1E2E"
            StrokeShape="RoundRectangle 24,24,0,0"
            StrokeThickness="0"
            VerticalOptions="End"
            TranslationY="700"
            IsVisible="False">
            <VerticalStackLayout Padding="20,16,20,36" Spacing="16">

                <BoxView
                    HeightRequest="4"
                    WidthRequest="40"
                    BackgroundColor="#45475A"
                    CornerRadius="2"
                    HorizontalOptions="Center" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="Nueva rutina"
                        TextColor="#CDD6F4"
                        VerticalOptions="Center" />
                    <Border
                        Grid.Column="1"
                        BackgroundColor="#313244"
                        HeightRequest="36"
                        WidthRequest="36"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseSheetTapped" />
                        </Border.GestureRecognizers>
                        <mi:MauiIcon
                            Icon="{mi:Material Close}"
                            IconColor="#6C7086"
                            IconSize="18"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Border
                    BackgroundColor="#252536"
                    Padding="16,12"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="0">
                    <VerticalStackLayout Spacing="4">
                        <Label FontSize="11" Text="NOMBRE" TextColor="#6C7086" CharacterSpacing="1" />
                        <Entry
                            x:Name="NameEntry"
                            Text="{Binding NewName}"
                            TextColor="#CDD6F4"
                            PlaceholderColor="#45475A"
                            Placeholder="ej. Push Pull Legs"
                            BackgroundColor="Transparent"
                            FontSize="15" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    BackgroundColor="#252536"
                    Padding="16,12"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="0">
                    <VerticalStackLayout Spacing="4">
                        <Label FontSize="11" Text="NOTAS (OPCIONAL)" TextColor="#6C7086" CharacterSpacing="1" />
                        <Entry
                            Text="{Binding NewNotes}"
                            TextColor="#CDD6F4"
                            PlaceholderColor="#45475A"
                            Placeholder="Objetivo, frecuencia..."
                            BackgroundColor="Transparent"
                            FontSize="15" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    BackgroundColor="#A6E3A1"
                    Padding="0,16"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCreateTapped" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="Crear rutina"
                        FontAttributes="Bold"
                        FontSize="16"
                        TextColor="#1E1E2E"
                        HorizontalOptions="Center" />
                </Border>

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
