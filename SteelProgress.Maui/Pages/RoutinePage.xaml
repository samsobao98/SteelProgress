<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SteelProgress.Maui.Pages.RoutinePage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:converters="clr-namespace:SteelProgress.Maui.Converters;assembly=SteelProgress.Maui"
    xmlns:controls="clr-namespace:SteelProgress.Maui.Controls"
    BackgroundColor="{StaticResource SpBg}"
    Shell.NavBarIsVisible="False"
    Title="Rutinas">

    <ContentPage.Resources>
        <converters:RoutineAccentConverter x:Key="Accent" />

        <!-- Rutina activa: placa protagonista con la semana y lo que toca -->
        <DataTemplate x:Key="ActiveRoutineTemplate">
            <Grid Padding="0,0,0,12">
                <SwipeView IsEnabled="{Binding BindingContext.IsNotReordering, Source={x:Reference Page}}" BackgroundColor="Transparent">
                    <SwipeView.RightItems>
                        <SwipeItems Mode="Execute">
                            <SwipeItem Text="Eliminar" BackgroundColor="#2EF38BA8" Invoked="OnSwipeDeleteInvoked" />
                        </SwipeItems>
                    </SwipeView.RightItems>
                    <Border Padding="18" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                                <GradientStop Color="#2C2D45" Offset="0" />
                                <GradientStop Color="#252536" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRoutineTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border BackgroundColor="#29B4BEFE" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="9,4">
                                    <Label Text="● ACTIVA" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{StaticResource SpSteel2}" />
                                </Border>
                                <mi:MauiIcon Grid.Column="1" Icon="{mi:Material DragHandle}" IconColor="{StaticResource SpText4}" IconSize="22"
                                             HorizontalOptions="End" IsVisible="{Binding BindingContext.IsReordering, Source={x:Reference Page}}" />
                            </Grid>
                            <Label Text="{Binding Name}" FontFamily="SpaceGroteskBold" FontSize="22" TextColor="{StaticResource SpText}" Margin="0,10,0,0" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding SubtitleText}" Style="{StaticResource SpSecondary}" Margin="0,2,0,0" />

                            <!-- Un tramo por día: lleno si se ha hecho esta semana -->
                            <FlexLayout Margin="0,14,0,0" HeightRequest="6" BindableLayout.ItemsSource="{Binding Week}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid FlexLayout.Grow="1" FlexLayout.Basis="0" Padding="3,0">
                                            <Border HeightRequest="6" StrokeThickness="0" StrokeShape="RoundRectangle 3" BackgroundColor="#3A3B52">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Done}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SpSteelBrush}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                <Label Text="{Binding WeekText}" Style="{StaticResource SpSecondary}" FontSize="12" />
                                <Label Grid.Column="1" FontSize="12" IsVisible="{Binding HasNextDay}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Toca: " TextColor="{StaticResource SpText3}" />
                                            <Span Text="{Binding NextDayName}" FontFamily="OpenSansSemibold" TextColor="{StaticResource SpText}" />
                                            <Span Text=" ›" TextColor="{StaticResource SpText3}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </SwipeView>
            </Grid>
        </DataTemplate>

        <!-- Resto de rutinas: tarjeta con insignia -->
        <DataTemplate x:Key="RoutineCardTemplate">
            <Grid Padding="0,0,0,12">
                <SwipeView IsEnabled="{Binding BindingContext.IsNotReordering, Source={x:Reference Page}}" BackgroundColor="Transparent">
                    <SwipeView.RightItems>
                        <SwipeItems Mode="Execute">
                            <SwipeItem Text="Eliminar" BackgroundColor="#2EF38BA8" Invoked="OnSwipeDeleteInvoked" />
                        </SwipeItems>
                    </SwipeView.RightItems>
                    <Border Style="{StaticResource SpCardStyle}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRoutineTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center"
                                    BackgroundColor="{Binding AccentIndex, Converter={StaticResource Accent}, ConverterParameter=bg}">
                                <Label Text="{Binding Monogram}" FontFamily="SpaceGroteskBold" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"
                                       TextColor="{Binding AccentIndex, Converter={StaticResource Accent}}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource SpText}" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding SubtitleText}" Style="{StaticResource SpSecondary}" />
                            </VerticalStackLayout>
                            <Grid Grid.Column="2" VerticalOptions="Center">
                                <Label Text="›" FontSize="22" TextColor="{StaticResource SpText4}" IsVisible="{Binding BindingContext.IsNotReordering, Source={x:Reference Page}}" />
                                <mi:MauiIcon Icon="{mi:Material DragHandle}" IconColor="{StaticResource SpText4}" IconSize="22" IsVisible="{Binding BindingContext.IsReordering, Source={x:Reference Page}}" />
                            </Grid>
                        </Grid>
                    </Border>
                </SwipeView>
            </Grid>
        </DataTemplate>

        <controls:RoutineTemplateSelector
            x:Key="RoutineTemplates"
            ActiveTemplate="{StaticResource ActiveRoutineTemplate}"
            CardTemplate="{StaticResource RoutineCardTemplate}" />
    </ContentPage.Resources>

    <Grid>

        <!-- Orb decorativo -->
        <AbsoluteLayout InputTransparent="True" IsClippedToBounds="True">
            <Ellipse
                AbsoluteLayout.LayoutBounds="1, 0, 280, 280"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                TranslationX="110"
                TranslationY="-90"
                Fill="#89B4FA"
                Opacity="0.06" />
        </AbsoluteLayout>

        <!-- ── Contenido principal ── -->
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- Cabecera: título, resumen, importar y ordenar -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="20,20,20,14">
                <VerticalStackLayout VerticalOptions="End">
                    <Label Text="Rutinas" Style="{StaticResource SpTitle}" />
                    <Label Text="{Binding HeaderText}" Style="{StaticResource SpSecondary}" IsVisible="{Binding HasRoutines}" />
                </VerticalStackLayout>
                <!-- Importar una rutina compartida (.steel) -->
                <Border Grid.Column="1" BackgroundColor="{StaticResource SpCard}" HeightRequest="36" WidthRequest="36"
                        StrokeShape="RoundRectangle 10" StrokeThickness="0" VerticalOptions="End"
                        IsVisible="{Binding IsNotReordering}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnImportTapped" />
                    </Border.GestureRecognizers>
                    <mi:MauiIcon Icon="{mi:Material FileDownload}" IconColor="{StaticResource SpText2}" IconSize="20"
                                 HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Border Grid.Column="2" x:Name="OrderButton" BackgroundColor="{StaticResource SpCard}" Padding="12,8"
                        StrokeShape="RoundRectangle 10" StrokeThickness="0" VerticalOptions="End" IsVisible="{Binding HasRoutines}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOrderTapped" />
                    </Border.GestureRecognizers>
                    <Label x:Name="OrderButtonLabel" Text="Ordenar" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource SpText2}" />
                </Border>
            </Grid>

            <!-- Con un cliente activo, estas rutinas son las suyas -->
            <controls:ActiveClientBanner Grid.Row="1" Margin="20,0,20,12" />

            <!-- Lista de rutinas -->
            <CollectionView
                x:Name="RoutineList"
                Grid.Row="2"
                ItemsSource="{Binding Items}"
                ItemTemplate="{StaticResource RoutineTemplates}"
                CanReorderItems="{Binding IsReordering}"
                Opacity="0"
                Margin="20,0,20,0">
                <CollectionView.Footer>
                    <VerticalStackLayout Padding="0,0,0,96">
                        <Label HorizontalTextAlignment="Center" Style="{StaticResource SpSecondary}" FontSize="12" IsVisible="{Binding HasRoutines}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsReordering}" Value="True">
                                    <Setter Property="Text" Value="Mantén pulsada una rutina y arrástrala · Hecho para guardar" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsReordering}" Value="False">
                                    <Setter Property="Text" Value="← Desliza para eliminar · «Ordenar» para cambiar el orden" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </CollectionView.Footer>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="0,60" Spacing="14" HorizontalOptions="Center">
                        <mi:MauiIcon Icon="{mi:Material ListAlt}" IconColor="{StaticResource SpCardHi}" IconSize="52" HorizontalOptions="Center" />
                        <Label HorizontalTextAlignment="Center" Text="Sin rutinas todavía" Style="{StaticResource SpBody}" TextColor="{StaticResource SpText3}" />
                        <Label HorizontalTextAlignment="Center" Text="Toca + para crear la primera" Style="{StaticResource SpSecondary}" TextColor="{StaticResource SpText4}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

        </Grid>

        <!-- ── Aviso de deshacer ── -->
        <Border
            x:Name="UndoBar"
            IsVisible="{Binding HasPendingDelete}"
            BackgroundColor="{StaticResource SpCardHi}"
            StrokeShape="RoundRectangle 14"
            StrokeThickness="0"
            Padding="16,12"
            Margin="20,0,96,28"
            VerticalOptions="End">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Text="{Binding PendingDeleteText}" Style="{StaticResource SpBody}" FontSize="14" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                <Label Grid.Column="1" Text="Deshacer" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource SpSteel2}" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding UndoDeleteCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>

        <!-- ── FAB ── -->
        <!-- Sin animar: Scale/Opacity sobre un elemento con Shadow deja la sombra borrosa en Android -->
        <Border
            x:Name="FabButton"
            Background="{StaticResource SpSteelBrush}"
            HeightRequest="58"
            WidthRequest="58"
            StrokeShape="RoundRectangle 18"
            StrokeThickness="0"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,20,24"
            IsVisible="{Binding IsNotReordering}"
            Shadow="{Shadow Brush='#B4BEFE', Offset='0,6', Radius=14, Opacity=0.35}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnFabTapped" />
            </Border.GestureRecognizers>
            <mi:MauiIcon Icon="{mi:Material Add}" IconColor="{StaticResource SpOnAccent}" IconSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>

        <!-- ── Overlay backdrop ── -->
        <BoxView
            x:Name="OverlayBackdrop"
            BackgroundColor="#0A0A10"
            Opacity="0"
            IsVisible="False"
            InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackdropTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- ── Bottom sheet: nueva rutina ── -->
        <Border
            x:Name="BottomSheet"
            Style="{StaticResource SpSheetStyle}"
            VerticalOptions="End"
            TranslationY="700"
            IsVisible="False">
            <VerticalStackLayout Spacing="16" Padding="0,0,0,8">
                <BoxView HeightRequest="4" WidthRequest="40" Color="{StaticResource SpText4}" CornerRadius="2" HorizontalOptions="Center" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Label Text="Nueva rutina" Style="{StaticResource SpHeading}" FontSize="20" VerticalOptions="Center" />
                    <Border Grid.Column="1" BackgroundColor="{StaticResource SpCardHi}" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseSheetTapped" />
                        </Border.GestureRecognizers>
                        <mi:MauiIcon Icon="{mi:Material Close}" IconColor="{StaticResource SpText3}" IconSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Border Style="{StaticResource SpCardStyle}" Padding="16,12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nombre" Style="{StaticResource SpOverline}" />
                        <Entry x:Name="NameEntry" Text="{Binding NewName}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}"
                               Placeholder="ej. Push Pull Legs" BackgroundColor="Transparent" FontSize="15" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource SpCardStyle}" Padding="16,12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Notas (opcional)" Style="{StaticResource SpOverline}" />
                        <Entry Text="{Binding NewNotes}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}"
                               Placeholder="Objetivo, frecuencia..." BackgroundColor="Transparent" FontSize="15" />
                    </VerticalStackLayout>
                </Border>

                <Border Background="{StaticResource SpSteelBrush}" Padding="0,16" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCreateTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="Crear rutina" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource SpOnAccent}" HorizontalOptions="Center" />
                </Border>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
