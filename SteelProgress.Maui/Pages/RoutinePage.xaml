<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SteelProgress.Maui.Pages.RoutinePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:SteelProgress.Maui.Converters"
    BackgroundColor="#1E1E2E"
    Title="Rutinas">

    <ContentPage.Resources>
        <conv:PrescriptionTextConverter x:Key="PrescriptionText" />
        <conv:StringNotNullOrEmptyConverter x:Key="NotEmpty" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header -->
        <Border
            Grid.Row="0"
            BackgroundColor="#313244"
            Margin="12,12,12,0"
            Padding="16"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="0">
            <VerticalStackLayout Spacing="4">
                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    Text="Rutinas"
                    TextColor="#CDD6F4" />
                <Label
                    FontSize="13"
                    Text="Organiza tus rutinas, días y ejercicios"
                    TextColor="#BAC2DE" />
            </VerticalStackLayout>
        </Border>

        <!-- Selector de sección -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,*,*"
            ColumnSpacing="6"
            Margin="12,10,12,0">
            <Button
                x:Name="BtnRutinas"
                Grid.Column="0"
                BackgroundColor="#89B4FA"
                Clicked="OnRutinasClicked"
                FontSize="13"
                Text="Rutinas"
                TextColor="#1E1E2E" />
            <Button
                x:Name="BtnDias"
                Grid.Column="1"
                BackgroundColor="#45475A"
                Clicked="OnDiasClicked"
                FontSize="13"
                Text="Días"
                TextColor="#CDD6F4" />
            <Button
                x:Name="BtnEjercicios"
                Grid.Column="2"
                BackgroundColor="#45475A"
                Clicked="OnEjerciciosClicked"
                FontSize="13"
                Text="Ejercicios"
                TextColor="#CDD6F4" />
        </Grid>

        <!-- ===== SECCIÓN RUTINAS ===== -->
        <CollectionView
            x:Name="SectionRutinas"
            Grid.Row="2"
            ItemsSource="{Binding Routines}"
            Margin="12,10,12,0"
            SelectedItem="{Binding SelectedRoutine, Mode=TwoWay}"
            SelectionMode="Single">
            <CollectionView.EmptyView>
                <Label
                    HorizontalTextAlignment="Center"
                    Text="No hay rutinas registradas"
                    TextColor="#585B70"
                    VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        BackgroundColor="#313244"
                        Margin="0,0,0,8"
                        Padding="14"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="0">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                FontAttributes="Bold"
                                FontSize="15"
                                Text="{Binding Name}"
                                TextColor="#CDD6F4" />
                            <Label
                                FontSize="12"
                                Text="{Binding Notes}"
                                TextColor="#6C7086" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ===== SECCIÓN DÍAS ===== -->
        <Grid
            x:Name="SectionDias"
            Grid.Row="2"
            IsVisible="False"
            Margin="12,10,12,0"
            RowDefinitions="Auto,*">
            <Border
                Grid.Row="0"
                BackgroundColor="#313244"
                Margin="0,0,0,8"
                Padding="10,8"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="0">
                <Label
                    FontSize="13"
                    Text="{Binding SelectedRoutine.Name, StringFormat='Rutina: {0}'}"
                    TextColor="#89B4FA" />
            </Border>
            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding RoutineDays}"
                SelectedItem="{Binding SelectedRoutineDay, Mode=TwoWay}"
                SelectionMode="Single">
                <CollectionView.EmptyView>
                    <Label
                        HorizontalTextAlignment="Center"
                        Text="No hay días en esta rutina"
                        TextColor="#585B70"
                        VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            BackgroundColor="#313244"
                            Margin="0,0,0,8"
                            Padding="14"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Margin="0,0,10,0"
                                    Text="{Binding Order, StringFormat='{0}.'}"
                                    TextColor="#89B4FA"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="15"
                                    Text="{Binding Name}"
                                    TextColor="#CDD6F4"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- ===== SECCIÓN EJERCICIOS ===== -->
        <Grid
            x:Name="SectionEjercicios"
            Grid.Row="2"
            IsVisible="False"
            Margin="12,10,12,0"
            RowDefinitions="Auto,*">
            <Border
                Grid.Row="0"
                BackgroundColor="#313244"
                Margin="0,0,0,8"
                Padding="10,8"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="0">
                <Label
                    FontSize="13"
                    Text="{Binding SelectedRoutineDay.Name, StringFormat='Día: {0}'}"
                    TextColor="#A6E3A1" />
            </Border>
            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding DayExercises}"
                SelectedItem="{Binding SelectedDayExercise, Mode=TwoWay}"
                SelectionMode="Single">
                <CollectionView.EmptyView>
                    <Label
                        HorizontalTextAlignment="Center"
                        Text="No hay ejercicios en este día"
                        TextColor="#585B70"
                        VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            BackgroundColor="#313244"
                            Margin="0,0,0,8"
                            Padding="14"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Margin="0,0,10,0"
                                    Text="{Binding Order, StringFormat='{0}.'}"
                                    TextColor="#A6E3A1"
                                    VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        FontSize="15"
                                        Text="{Binding Exercise.Name}"
                                        TextColor="#CDD6F4" />
                                    <!-- Lo prescrito: "4 × 6–8 · RPE 8 · 1:30" -->
                                    <Label
                                        FontFamily="SpaceGroteskMedium"
                                        FontSize="12"
                                        Text="{Binding ., Converter={StaticResource PrescriptionText}}"
                                        TextColor="{StaticResource SpText3}"
                                        IsVisible="{Binding ., Converter={StaticResource PrescriptionText}, ConverterParameter=visible}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Formulario Rutinas -->
        <Border
            x:Name="FormRutinas"
            Grid.Row="3"
            BackgroundColor="#313244"
            Margin="12"
            Padding="16"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="0">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label FontSize="12" Text="Nombre" TextColor="#BAC2DE" />
                        <Entry
                            BackgroundColor="#45475A"
                            Placeholder="Nombre de la rutina"
                            PlaceholderColor="#585B70"
                            Text="{Binding Name}"
                            TextColor="#CDD6F4" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label FontSize="12" Text="Notas" TextColor="#BAC2DE" />
                        <Entry
                            BackgroundColor="#45475A"
                            Placeholder="Notas opcionales"
                            PlaceholderColor="#585B70"
                            Text="{Binding Notes}"
                            TextColor="#CDD6F4" />
                    </VerticalStackLayout>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button
                        Grid.Column="0"
                        BackgroundColor="#89B4FA"
                        Command="{Binding AddRoutineCommand}"
                        Text="Añadir rutina"
                        TextColor="#1E1E2E" />
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#F38BA8"
                        Command="{Binding DeleteRoutineCommand}"
                        Text="Eliminar"
                        TextColor="#1E1E2E" />
                </Grid>
                <!-- Compartir la rutina seleccionada o importar un .steel -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button
                        x:Name="ShareButton"
                        Grid.Column="0"
                        Style="{StaticResource SpPrimaryButton}"
                        Padding="12,10"
                        Text="↗ Compartir"
                        Clicked="OnShareClicked" />
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource SpSecondaryButton}"
                        Padding="12,10"
                        Text="↓ Importar"
                        Clicked="OnImportClicked" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Formulario Días -->
        <Border
            x:Name="FormDias"
            Grid.Row="3"
            BackgroundColor="#313244"
            IsVisible="False"
            Margin="12"
            Padding="16"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="0">
            <VerticalStackLayout Spacing="10">
                <VerticalStackLayout Spacing="4">
                    <Label FontSize="12" Text="Nombre del día" TextColor="#BAC2DE" />
                    <Entry
                        BackgroundColor="#45475A"
                        Placeholder="Ej. Día de pecho"
                        PlaceholderColor="#585B70"
                        Text="{Binding DayName}"
                        TextColor="#CDD6F4" />
                </VerticalStackLayout>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button
                        Grid.Column="0"
                        BackgroundColor="#89B4FA"
                        Command="{Binding AddDayCommand}"
                        Text="Añadir día"
                        TextColor="#1E1E2E" />
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#F38BA8"
                        Command="{Binding DeleteDayCommand}"
                        Text="Eliminar día"
                        TextColor="#1E1E2E" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Formulario Ejercicios -->
        <Border
            x:Name="FormEjercicios"
            Grid.Row="3"
            BackgroundColor="#313244"
            IsVisible="False"
            Margin="12"
            Padding="16"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="0">
            <VerticalStackLayout Spacing="10">
                <VerticalStackLayout Spacing="4">
                    <Label FontSize="12" Text="Ejercicio" TextColor="#BAC2DE" />
                    <Picker
                        BackgroundColor="#45475A"
                        ItemDisplayBinding="{Binding Name}"
                        ItemsSource="{Binding AllExercises}"
                        SelectedItem="{Binding SelectedExerciseToAdd}"
                        Title="Selecciona un ejercicio"
                        TitleColor="#585B70"
                        TextColor="#CDD6F4" />
                </VerticalStackLayout>
                <Button
                    Command="{Binding EditPrescriptionCommand}"
                    Style="{StaticResource SpSecondaryButton}"
                    Padding="12,10"
                    Text="Editar series, reps e intensidad" />
                <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="6">
                    <Button
                        Grid.Column="0"
                        BackgroundColor="#89B4FA"
                        Command="{Binding AddExerciseToDayCommand}"
                        Text="Añadir"
                        TextColor="#1E1E2E" />
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#F38BA8"
                        Command="{Binding DeleteExerciseFromDayCommand}"
                        Text="Eliminar"
                        TextColor="#1E1E2E" />
                    <Button
                        Grid.Column="2"
                        BackgroundColor="#45475A"
                        Command="{Binding MoveExerciseUpCommand}"
                        Text="↑"
                        TextColor="#CDD6F4"
                        WidthRequest="48" />
                    <Button
                        Grid.Column="3"
                        BackgroundColor="#45475A"
                        Command="{Binding MoveExerciseDownCommand}"
                        Text="↓"
                        TextColor="#CDD6F4"
                        WidthRequest="48" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- ===== PANEL: EDITAR PRESCRIPCIÓN (sistema de diseño) ===== -->
        <Grid Grid.RowSpan="4" IsVisible="{Binding Editor.IsOpen}" BackgroundColor="#8C0A0A10">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding Editor.CloseCommand}" />
            </Grid.GestureRecognizers>

            <Border Style="{StaticResource SpSheetStyle}" VerticalOptions="End" MaximumHeightRequest="640">
                <!-- Tocar dentro del panel no lo cierra -->
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <ScrollView>
                    <VerticalStackLayout Spacing="14">
                        <BoxView HeightRequest="4" WidthRequest="40" CornerRadius="2" Color="{StaticResource SpText4}" HorizontalOptions="Center" />
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Editor.ExerciseName}" Style="{StaticResource SpHeading}" />
                            <Label Text="Vacío = sin indicar" Style="{StaticResource SpSecondary}" FontSize="12" />
                        </VerticalStackLayout>

                        <!-- Básico: siempre -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Series" Style="{StaticResource SpSecondary}" FontSize="12" />
                                <Entry Text="{Binding Editor.Sets}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" FontFamily="SpaceGroteskBold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Reps" Style="{StaticResource SpSecondary}" FontSize="12" />
                                <Entry Text="{Binding Editor.Reps}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" FontFamily="SpaceGroteskBold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4" IsVisible="{Binding Editor.ShowRepRange}">
                                <Label Text="Hasta (rango)" Style="{StaticResource SpSecondary}" FontSize="12" />
                                <Entry Text="{Binding Editor.RepsMax}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" FontFamily="SpaceGroteskBold" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Intensidad -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding Editor.ShowIntensity}">
                            <Label Text="Intensidad" Style="{StaticResource SpOverline}" TextColor="{StaticResource SpIntensity}" />
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Peso kg" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.Weight}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="% 1RM" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.Percent1RM}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="4">
                                    <Label Text="RPE" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.Rpe}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="3" Spacing="4">
                                    <Label Text="RIR" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.Rir}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Tempo y descanso -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding Editor.ShowTempoAndRest}">
                            <Label Text="Tempo y descanso" Style="{StaticResource SpOverline}" TextColor="{StaticResource SpRest}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Tempo (3-1-1-0)" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.Tempo}" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Descanso (segundos)" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.RestSeconds}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Estructura avanzada -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding Editor.ShowStructure}">
                            <Label Text="Estructura" Style="{StaticResource SpOverline}" TextColor="{StaticResource SpSteel2}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Superserie (A1, A2…)" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.GroupLabel}" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Series de calentamiento" Style="{StaticResource SpSecondary}" FontSize="12" />
                                    <Entry Text="{Binding Editor.WarmupSets}" Keyboard="Numeric" Placeholder="—" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Notas: siempre -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Notas" Style="{StaticResource SpSecondary}" FontSize="12" />
                            <Editor Text="{Binding Editor.Notes}" AutoSize="TextChanges" Placeholder="Indicaciones para este ejercicio" BackgroundColor="{StaticResource SpBg}" TextColor="{StaticResource SpText}" PlaceholderColor="{StaticResource SpText4}" />
                        </VerticalStackLayout>

                        <Label Text="{Binding Editor.Error}" TextColor="{StaticResource SpDanger}" FontSize="13" IsVisible="{Binding Editor.Error, Converter={StaticResource NotEmpty}}" />

                        <Grid ColumnDefinitions="*,2*" ColumnSpacing="8">
                            <Button Text="Cancelar" Style="{StaticResource SpSecondaryButton}" Command="{Binding Editor.CloseCommand}" />
                            <Button Grid.Column="1" Text="Guardar" Style="{StaticResource SpPrimaryButton}" Command="{Binding Editor.SaveCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
