<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SteelProgress.Maui.Pages.RoutinePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#1E1E2E"
    Title="Rutinas">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header -->
        <Border
            Grid.Row="0"
            BackgroundColor="#313244"
            Margin="12,12,12,0"
            Padding="16"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="0">
            <VerticalStackLayout Spacing="4">
                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    Text="Rutinas"
                    TextColor="#CDD6F4" />
                <Label
                    FontSize="13"
                    Text="Organiza tus rutinas, días y ejercicios"
                    TextColor="#BAC2DE" />
            </VerticalStackLayout>
        </Border>

        <!-- Selector de sección -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,*,*"
            ColumnSpacing="6"
            Margin="12,10,12,0">
            <Button
                x:Name="BtnRutinas"
                Grid.Column="0"
                BackgroundColor="#89B4FA"
                Clicked="OnRutinasClicked"
                FontSize="13"
                Text="Rutinas"
                TextColor="#1E1E2E" />
            <Button
                x:Name="BtnDias"
                Grid.Column="1"
                BackgroundColor="#45475A"
                Clicked="OnDiasClicked"
                FontSize="13"
                Text="Días"
                TextColor="#CDD6F4" />
            <Button
                x:Name="BtnEjercicios"
                Grid.Column="2"
                BackgroundColor="#45475A"
                Clicked="OnEjerciciosClicked"
                FontSize="13"
                Text="Ejercicios"
                TextColor="#CDD6F4" />
        </Grid>

        <!-- ===== SECCIÓN RUTINAS ===== -->
        <CollectionView
            x:Name="SectionRutinas"
            Grid.Row="2"
            ItemsSource="{Binding Routines}"
            Margin="12,10,12,0"
            SelectedItem="{Binding SelectedRoutine, Mode=TwoWay}"
            SelectionMode="Single">
            <CollectionView.EmptyView>
                <Label
                    HorizontalTextAlignment="Center"
                    Text="No hay rutinas registradas"
                    TextColor="#585B70"
                    VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        BackgroundColor="#313244"
                        Margin="0,0,0,8"
                        Padding="14"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="0">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                FontAttributes="Bold"
                                FontSize="15"
                                Text="{Binding Name}"
                                TextColor="#CDD6F4" />
                            <Label
                                FontSize="12"
                                Text="{Binding Notes}"
                                TextColor="#6C7086" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ===== SECCIÓN DÍAS ===== -->
        <Grid
            x:Name="SectionDias"
            Grid.Row="2"
            IsVisible="False"
            Margin="12,10,12,0"
            RowDefinitions="Auto,*">
            <Border
                Grid.Row="0"
                BackgroundColor="#313244"
                Margin="0,0,0,8"
                Padding="10,8"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="0">
                <Label
                    FontSize="13"
                    Text="{Binding SelectedRoutine.Name, StringFormat='Rutina: {0}'}"
                    TextColor="#89B4FA" />
            </Border>
            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding RoutineDays}"
                SelectedItem="{Binding SelectedRoutineDay, Mode=TwoWay}"
                SelectionMode="Single">
                <CollectionView.EmptyView>
                    <Label
                        HorizontalTextAlignment="Center"
                        Text="No hay días en esta rutina"
                        TextColor="#585B70"
                        VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            BackgroundColor="#313244"
                            Margin="0,0,0,8"
                            Padding="14"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Margin="0,0,10,0"
                                    Text="{Binding Order, StringFormat='{0}.'}"
                                    TextColor="#89B4FA"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="15"
                                    Text="{Binding Name}"
                                    TextColor="#CDD6F4"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- ===== SECCIÓN EJERCICIOS ===== -->
        <Grid
            x:Name="SectionEjercicios"
            Grid.Row="2"
            IsVisible="False"
            Margin="12,10,12,0"
            RowDefinitions="Auto,*">
            <Border
                Grid.Row="0"
                BackgroundColor="#313244"
                Margin="0,0,0,8"
                Padding="10,8"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="0">
                <Label
                    FontSize="13"
                    Text="{Binding SelectedRoutineDay.Name, StringFormat='Día: {0}'}"
                    TextColor="#A6E3A1" />
            </Border>
            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding DayExercises}"
                SelectedItem="{Binding SelectedDayExercise, Mode=TwoWay}"
                SelectionMode="Single">
                <CollectionView.EmptyView>
                    <Label
                        HorizontalTextAlignment="Center"
                        Text="No hay ejercicios en este día"
                        TextColor="#585B70"
                        VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            BackgroundColor="#313244"
                            Margin="0,0,0,8"
                            Padding="14"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Margin="0,0,10,0"
                                    Text="{Binding Order, StringFormat='{0}.'}"
                                    TextColor="#A6E3A1"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="15"
                                    Text="{Binding Exercise.Name}"
                                    TextColor="#CDD6F4"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Formulario Rutinas -->
        <Border
            x:Name="FormRutinas"
            Grid.Row="3"
            BackgroundColor="#313244"
            Margin="12"
            Padding="16"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="0">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label FontSize="12" Text="Nombre" TextColor="#BAC2DE" />
                        <Entry
                            BackgroundColor="#45475A"
                            Placeholder="Nombre de la rutina"
                            PlaceholderColor="#585B70"
                            Text="{Binding Name}"
                            TextColor="#CDD6F4" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label FontSize="12" Text="Notas" TextColor="#BAC2DE" />
                        <Entry
                            BackgroundColor="#45475A"
                            Placeholder="Notas opcionales"
                            PlaceholderColor="#585B70"
                            Text="{Binding Notes}"
                            TextColor="#CDD6F4" />
                    </VerticalStackLayout>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button
                        Grid.Column="0"
                        BackgroundColor="#89B4FA"
                        Command="{Binding AddRoutineCommand}"
                        Text="Añadir rutina"
                        TextColor="#1E1E2E" />
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#F38BA8"
                        Command="{Binding DeleteRoutineCommand}"
                        Text="Eliminar"
                        TextColor="#1E1E2E" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Formulario Días -->
        <Border
            x:Name="FormDias"
            Grid.Row="3"
            BackgroundColor="#313244"
            IsVisible="False"
            Margin="12"
            Padding="16"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="0">
            <VerticalStackLayout Spacing="10">
                <VerticalStackLayout Spacing="4">
                    <Label FontSize="12" Text="Nombre del día" TextColor="#BAC2DE" />
                    <Entry
                        BackgroundColor="#45475A"
                        Placeholder="Ej. Día de pecho"
                        PlaceholderColor="#585B70"
                        Text="{Binding DayName}"
                        TextColor="#CDD6F4" />
                </VerticalStackLayout>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button
                        Grid.Column="0"
                        BackgroundColor="#89B4FA"
                        Command="{Binding AddDayCommand}"
                        Text="Añadir día"
                        TextColor="#1E1E2E" />
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#F38BA8"
                        Command="{Binding DeleteDayCommand}"
                        Text="Eliminar día"
                        TextColor="#1E1E2E" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Formulario Ejercicios -->
        <Border
            x:Name="FormEjercicios"
            Grid.Row="3"
            BackgroundColor="#313244"
            IsVisible="False"
            Margin="12"
            Padding="16"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="0">
            <VerticalStackLayout Spacing="10">
                <VerticalStackLayout Spacing="4">
                    <Label FontSize="12" Text="Ejercicio" TextColor="#BAC2DE" />
                    <Picker
                        BackgroundColor="#45475A"
                        ItemDisplayBinding="{Binding Name}"
                        ItemsSource="{Binding AllExercises}"
                        SelectedItem="{Binding SelectedExerciseToAdd}"
                        Title="Selecciona un ejercicio"
                        TitleColor="#585B70"
                        TextColor="#CDD6F4" />
                </VerticalStackLayout>
                <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="6">
                    <Button
                        Grid.Column="0"
                        BackgroundColor="#89B4FA"
                        Command="{Binding AddExerciseToDayCommand}"
                        Text="Añadir"
                        TextColor="#1E1E2E" />
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#F38BA8"
                        Command="{Binding DeleteExerciseFromDayCommand}"
                        Text="Eliminar"
                        TextColor="#1E1E2E" />
                    <Button
                        Grid.Column="2"
                        BackgroundColor="#45475A"
                        Command="{Binding MoveExerciseUpCommand}"
                        Text="↑"
                        TextColor="#CDD6F4"
                        WidthRequest="48" />
                    <Button
                        Grid.Column="3"
                        BackgroundColor="#45475A"
                        Command="{Binding MoveExerciseDownCommand}"
                        Text="↓"
                        TextColor="#CDD6F4"
                        WidthRequest="48" />
                </Grid>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
