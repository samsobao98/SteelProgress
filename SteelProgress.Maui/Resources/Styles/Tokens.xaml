<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Sistema de diseño de SteelProgress (docs/DISENO_ENTRENADORES_Y_COMPARTIR.md §12.1).
    Todo se define aquí una sola vez; las páginas usan estas claves en lugar de escribir colores a mano.
    Las claves llevan el prefijo "Sp" para no chocar con las de la plantilla (Colors.xaml, Styles.xaml).
    Los estilos tienen clave: no cambian nada hasta que una página los usa con Style="{StaticResource ...}".
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ── Superficies ── -->
    <Color x:Key="SpBgDeep">#161622</Color>
    <Color x:Key="SpBg">#1E1E2E</Color>
    <Color x:Key="SpCard">#252536</Color>
    <Color x:Key="SpCardHi">#2C2D42</Color>
    <Color x:Key="SpSheet">#232334</Color>
    <Color x:Key="SpLine">#34354A</Color>

    <!-- ── Texto ── -->
    <Color x:Key="SpText">#CDD6F4</Color>
    <Color x:Key="SpText2">#A6ADC8</Color>
    <Color x:Key="SpText3">#6C7086</Color>
    <Color x:Key="SpText4">#45475A</Color>
    <Color x:Key="SpOnAccent">#1B1B2B</Color>

    <!-- ── Marca: acero (solo botón principal, anillos y momentos importantes) ── -->
    <Color x:Key="SpSteel1">#89B4FA</Color>
    <Color x:Key="SpSteel2">#B4BEFE</Color>
    <Color x:Key="SpSteel3">#CBA6F7</Color>
    <LinearGradientBrush x:Key="SpSteelBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#89B4FA" Offset="0" />
        <GradientStop Color="#B4BEFE" Offset="0.55" />
        <GradientStop Color="#CBA6F7" Offset="1" />
    </LinearGradientBrush>

    <!-- ── Colores con significado fijo ── -->
    <Color x:Key="SpOk">#A6E3A1</Color>
    <Color x:Key="SpIntensity">#FAB387</Color>
    <Color x:Key="SpRest">#94E2D5</Color>
    <Color x:Key="SpRecord">#F9E2AF</Color>
    <Color x:Key="SpDanger">#F38BA8</Color>

    <!-- ── Radios y espaciado ── -->
    <x:Double x:Key="SpRadiusS">8</x:Double>
    <x:Double x:Key="SpRadiusM">14</x:Double>
    <x:Double x:Key="SpRadiusL">20</x:Double>
    <x:Double x:Key="SpSpace1">4</x:Double>
    <x:Double x:Key="SpSpace2">8</x:Double>
    <x:Double x:Key="SpSpace3">12</x:Double>
    <x:Double x:Key="SpSpace4">16</x:Double>
    <x:Double x:Key="SpSpace5">24</x:Double>
    <x:Double x:Key="SpSpace6">32</x:Double>
    <Thickness x:Key="SpPagePadding">20,8,20,0</Thickness>

    <!-- ── Tipografía: Space Grotesk para números y títulos, Open Sans para texto ── -->
    <Style x:Key="SpTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="SpaceGroteskBold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{StaticResource SpText}" />
    </Style>
    <Style x:Key="SpHeading" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{StaticResource SpText}" />
    </Style>
    <Style x:Key="SpBody" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource SpText}" />
    </Style>
    <Style x:Key="SpSecondary" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource SpText3}" />
    </Style>
    <Style x:Key="SpOverline" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.5" />
        <Setter Property="TextColor" Value="{StaticResource SpText3}" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>
    <Style x:Key="SpNumber" TargetType="Label">
        <Setter Property="FontFamily" Value="SpaceGroteskBold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextColor" Value="{StaticResource SpText}" />
    </Style>
    <Style x:Key="SpNumberLarge" TargetType="Label">
        <Setter Property="FontFamily" Value="SpaceGroteskBold" />
        <Setter Property="FontSize" Value="46" />
        <Setter Property="TextColor" Value="{StaticResource SpText}" />
    </Style>

    <!-- ── Superficies ── -->
    <Style x:Key="SpCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource SpCard}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="SpCardHi" TargetType="Border" BasedOn="{StaticResource SpCard}">
        <Setter Property="BackgroundColor" Value="{StaticResource SpCardHi}" />
    </Style>
    <Style x:Key="SpSheet" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource SpSheet}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24,24,0,0" />
        <Setter Property="Padding" Value="20,12,20,28" />
    </Style>
    <Style x:Key="SpChip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource SpCardHi}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="9,4" />
    </Style>

    <!-- ── Botones ── -->
    <Style x:Key="SpPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SpSteelBrush}" />
        <Setter Property="TextColor" Value="{StaticResource SpOnAccent}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="16,15" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="SpSecondaryButton" TargetType="Button" BasedOn="{StaticResource SpPrimaryButton}">
        <Setter Property="Background" Value="{StaticResource SpCardHi}" />
        <Setter Property="TextColor" Value="{StaticResource SpText}" />
    </Style>
    <Style x:Key="SpDangerTextButton" TargetType="Button" BasedOn="{StaticResource SpPrimaryButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource SpDanger}" />
    </Style>

</ResourceDictionary>
